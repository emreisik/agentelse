// =============================================================================
// AUTH.JS + WORKSPACE
// =============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  accounts    Account[]
  sessions    Session[]
  memberships WorkspaceMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id   String @id @default(cuid())
  name String
  slug String @unique

  members  WorkspaceMember[]
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  domain      String?
  status      ProjectStatus @default(CREATED)
  // Selected during setup, required: determines which language and which
  // country market all AI research/reasoning calls focus on (see
  // src/lib/locales.ts). Migration-safe default for existing rows.
  // country is the first/primary element of countries — all reasoning/prompt
  // injection chokepoints (ReasoningService, Gemini providers,
  // ConstitutionService, etc.) still read ONLY this field for backward
  // compatibility. countries exists solely to store/display ALL target
  // markets selected in the setup wizard — business logic does not branch
  // on it.
  language    String        @default("en")
  country     String        @default("US")
  countries   String[]      @default([])

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brands    Brand[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([status])
}

model Brand {
  id          String  @id @default(cuid())
  workspaceId String
  projectId   String
  name        String
  slug        String
  isDefault   Boolean @default(true)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, slug])
  @@index([workspaceId])
  @@index([projectId])
}

// =============================================================================
// BRAND BRAIN
// =============================================================================

model BrandDossier {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String @unique

  summary          String?
  positioning      String?
  targetAudiences  Json?
  markets          Json?
  products         Json?
  services         Json?
  toneOfVoice      String?
  visualGuidelines Json?
  approvedColors   Json?
  approvedFonts    Json?
  logoAssetId      String?
  // Dark-colored variant of logoAssetId (which stays the light/default
  // logo for backward compat) — creative-template.ts picks between them
  // based on the sampled brightness of the generated image's logo region.
  darkLogoAssetId  String?
  // Mirrored from Project — the execution context builder already reads
  // the dossier via brandId, so no separate Project join is needed.
  language         String?
  country          String?

  currentStrategyVersionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([projectId])
}

enum PhotographyStyle {
  PHOTOGRAPHIC
  ILLUSTRATED
  THREE_D_RENDER
  FLAT_DESIGN
  MIXED
}

enum BackgroundTonePreference {
  LIGHT
  DARK
  BRAND_COLORED
  NO_PREFERENCE
}

enum LogoPosition {
  TOP_LEFT
  TOP_RIGHT
  BOTTOM_LEFT
  BOTTOM_RIGHT
  CENTER_BOTTOM
}

enum AccentBarPosition {
  TOP
  BOTTOM
}

// Structured, image-pipeline-facing visual identity — deliberately a
// separate model from BrandDossier rather than more fields there.
// BrandDossier's existing edit pattern is "raw JSON textarea for every
// structured field" (see brand-dossier-edit-sheet.tsx), which is exactly
// why approvedColors/approvedFonts never got a real UI. This model gets
// its own typed Sheet instead (see brand-visual-identity-actions.ts).
// BrandDossier.approvedColors/approvedFonts are untouched — no migration,
// no dual-write; a brand with no row here falls back to legacy behavior
// everywhere (creative-prompt-builder.ts, creative-template.ts).
model BrandVisualIdentity {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String @unique

  // {name?, hex}[] each, role-separated — unlike BrandDossier.approvedColors
  // (a flat, roleless array), the prompt builder and the deterministic
  // accent bar both need to know which color plays which role.
  primaryColors   Json?
  secondaryColors Json?
  accentColors    Json?

  photographyStyle PhotographyStyle?
  styleRefinement  String?
  moodTags         String[] @default([])
  compositionNotes String?
  backgroundTone   BackgroundTonePreference?

  // Brand-specific ADDITIONS to creative-prompt-builder.ts's hardcoded
  // global STYLE_AND_LIGHTING/AVOID baseline — not a replacement.
  alwaysInclude String[] @default([])
  alwaysAvoid   String[] @default([])

  // v1: a single "style board" reference image (an Asset, type IMAGE) sent
  // to the AI as referenceImage once the logo itself stops being sent that
  // way (see gemini-creative.provider.ts / creative-actions.ts Phase 2).
  referenceImageAssetId String?

  // Deterministic template config for applyBrandTemplate() — the ONLY
  // pixel-guaranteed (non-stochastic) part of a generated image. Defaults
  // reproduce today's hardcoded creative-template.ts behavior exactly, so
  // a brand that never opens the new settings sees no change.
  templateEnabled       Boolean           @default(true)
  logoPosition           LogoPosition      @default(BOTTOM_RIGHT)
  logoSizePercent        Int               @default(16)
  logoMarginPercent      Int               @default(4)
  accentBarEnabled       Boolean           @default(true)
  accentBarColorHex      String?
  accentBarHeightPercent Int               @default(5)
  accentBarPosition      AccentBarPosition @default(BOTTOM)

  // Named post layouts (src/lib/layout-templates.ts): {version:1, defaultId,
  // items[]}, each with logo / bar / headline placement. Validated in the
  // app (parseLayoutTemplates), so new layout options need no migration.
  // Null = the brand has none and the columns above apply, exactly as before.
  layoutTemplates Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([projectId])
}

model BrandFact {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  category   String
  key        String
  value      Json
  source     String?
  confidence Float?

  // Agency OS: research findings carry an explicit classification and an
  // evidence link (VERIFIED_FACT is only writable with evidence attached —
  // enforced in FindingWriter, mirrored here when facts are promoted).
  classification FactClassification?
  evidenceId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
  @@index([brandId, category])
}

