model AutonomyPolicy {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String @unique
  brandId     String

  setupAutoApprove Boolean @default(false)

  // Unlimited mode: disables the daily counter and budget caps. Counters
  // are still processed (so telemetry doesn't break), only the threshold
  // check is skipped. A separate flag instead of deleting the limits: when
  // turned off, the old caps come back exactly as they were.
  unlimitedMode Boolean @default(false)

  maxTasksPerDay             Int @default(25)
  maxReasoningCallsPerDay    Int @default(200)
  maxConcurrentResearchTasks Int @default(5)
  maxOpenOpportunities       Int @default(30)
  maxActiveIdeas             Int @default(20)

  // Backpressure cap read by AgencyDirector.decideOnIdea and
  // WorkHandoffEngine.accept via TaskRepository.countActiveSystemTasks —
  // caps how much SYSTEM-created work can be in flight at once for a
  // project, independent of the daily counter caps above.
  maxConcurrentSystemTasks Int @default(15)

  dailyBudgetUsd    Float?
  taskCooldownHours Int    @default(72)

  // Onay eşiği (billing, Faz 3C): sistemin kendi başlattığı bir görevin tahmini
  // maliyeti bunu aşarsa görev insan onayı bekler. null = paket varsayılanı
  // (src/lib/billing/approval-threshold.ts); kullanıcı yalnız paket varsayılanının
  // [0,10 ... 5 katı] aralığında seçer. Yalnız faturalama etkinken uygulanır.
  approveAboveUsd Float?

  // Hard ceiling for a single autonomously-proposed Meta ad campaign's
  // daily budget (see agency/meta-ads — the LLM-proposed dailyBudgetCents
  // is clamped to this before the campaign task is ever planned, so an
  // approver always sees a bounded number regardless of what the model
  // suggested). Dollars, same unit as dailyBudgetUsd above.
  maxCampaignDailyBudgetUsd Float @default(10)

  scoringWeights    Json?
  approvalOverrides Json?

  // The spec's simplified 3-mode trust dial (docs/brand-workspace-migration.md
  // §7 Phase 7) — deliberately NOT a new parallel approval system: it only
  // governs whether an autonomously-created Creative (today: only
  // instagram-week-planner.ts's weekly auto-planner) lands pre-approved or
  // waits in the SAME IN_REVIEW/Approval flow every human-triggered
  // creative already goes through. Default AUTOPILOT preserves today's
  // exact behavior for every existing project (no regression on migrate).
  autopilotMode AutopilotMode @default(AUTOPILOT)

  // Faz 5 (docs/brand-brain-loop.md): once the Sunday weekly draft (above)
  // has sat untouched for a while, prepare it automatically — save it and
  // start production — so the owner finds pieces waiting to approve instead
  // of an empty draft. Independent of autopilotMode (never reused for this:
  // see weekly-plan-draft.ts's header comment on why that field is already
  // spoken for). Default off: an existing project opts in explicitly: this
  // spends real money unattended, which "Weekly plan draft" alone does not.
  weeklyAutoProduce Boolean @default(false)

  // Meta Ads otomatik pilotu (docs/meta-ads-plan.md §1.2, F7): SUGGEST her
  // yazmayı onaya sorar; GUARDED yalnız riski azaltan eylemleri (duraklatma,
  // en çok %30 bütçe düşürme) kendisi yapar ve sonradan bildirir; FULL ayrıca
  // aylık tavan içinde sınırlı bütçe artışı yapar (önkoşullu). Yalnız
  // OWNER/ADMIN değiştirir; her değişiklik AuditLog'a yazılır.
  adsAutonomy         AdsAutonomyLevel @default(SUGGEST)
  // FULL'ün aylık harcama tavanı (reklam hesabı para biriminin alt
  // biriminde). Boşken FULL açılamaz.
  adsMonthlyCapMinor  BigInt?
  // F8 müşteri onaylayıcıları: OWNER/ADMIN olmayan ama bu projenin L4
  // (harcama) onayını verebilen workspace üyeleri (yalnız bu proje).
  adsSpendApproverIds String[]         @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

enum AutopilotMode {
  // Agentelse creates work; nothing is scheduled until a human reviews it.
  REVIEW_EVERYTHING
  // Agentelse creates AND schedules work, but still asks before it's
  // eligible to publish (lands at IN_REVIEW, pre-scheduled).
  CREATE_AUTOMATICALLY
  // Agentelse creates, schedules and publishes within configured caps —
  // today's existing default behavior.
  AUTOPILOT
}

enum AgencyLoopStatus {
  RUNNING
  WAITING
  BLOCKED
  PAUSED
  ERROR
}

enum AgencyCycleStatus {
  RUNNING
  COMPLETED
  NOOP
  FAILED
}

// Control/telemetry state for whether a project's agency loop is actually
// operating — NOT an alternative task queue (Task/ExecutionJob/AgencyTrigger
// remain the only work items). One row per project. Previously the only
// signal of "is this project's agency active" was Project.status, which
// only one engine (SignalUniverse.runDueScans) ever actually checked — this
// gives every other engine/the UI a single place to read/set it.
model AgencyLoopState {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String @unique
  brandId     String

  status AgencyLoopStatus @default(RUNNING)

  startedAt      DateTime  @default(now())
  lastTickAt     DateTime?
  lastProgressAt DateTime?
  nextWakeAt     DateTime?

  currentPhase    String?
  lastTriggerType AgencyTriggerType?
  blockedReason   String?

  consecutiveNoProgressCycles Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

// Append-only per-cycle telemetry — mainly operational/UI support (spec:
// "why did it wake up, what did it decide, what work did it create"), NOT a
// duplicate context store. One row per AgencyTrigger processed (triggerType/
// triggerId identify which); the count fields are best-effort snapshots of
// what that specific cycle did, distinct from AgencyDailyStat's per-day
// running totals (tasksCreated etc. there are already wired into
// AutonomyPolicyRepository.checkAndIncrement).
model AgencyCycle {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  triggerType AgencyTriggerType?
  triggerId   String?

  startedAt   DateTime          @default(now())
  completedAt DateTime?
  status      AgencyCycleStatus @default(RUNNING)

  signalsProcessed     Int @default(0)
  insightsCreated      Int @default(0)
  opportunitiesCreated Int @default(0)
  ideasCreated         Int @default(0)
  decisionsCreated     Int @default(0)
  tasksCreated         Int @default(0)
  handoffsCreated      Int @default(0)
  measurementsCreated  Int @default(0)
  learningsCreated     Int @default(0)

  errorCount Int @default(0)

  @@index([projectId, startedAt])
}

model AgencyDailyStat {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  date DateTime @db.Date

  tasksCreated         Int @default(0)
  reasoningCalls       Int @default(0)
  signalsIngested      Int @default(0)
  opportunitiesCreated Int @default(0)
  ideasCreated         Int @default(0)

  reasoningCostUsd Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, date])
  @@index([projectId])
}

// Faturalama temeli (~/.claude/plans/billing-usage-plan.md, Faz 1): her ücretli
// dış çağrının gerçek kullanımı ve USD maliyeti. ReasoningCall'dan farkı:
// (1) çağrı başına tek satır (yeniden denemeler ve kesik yanıtlar dahil),
// (2) workspace düzeyinde KALICIdır — kolon adı bilerek `projectRef` (FK'sız);
// ProjectDeletionService `projectId` adlı kolonu olan her tabloyu siler, marka
// silinince maliyet geçmişi de gitmesin. Para: USD x 1e6 (micros).
model UsageEntry {
  id          String  @id @default(cuid())
  // Kapsam bulunamadıysa "unattributed" (rapor bunları ayrıca sayar).
  workspaceId String
  projectRef  String?
  userId      String?

  // SOCIAL | ADS | ANALYTICS | SEO | CHAT | OTHER
  module      String?
  // reasoning | execution | chat | action | cron | embeddings ...
  source      String?
  // Aynı işin çağrılarını toplar (iş, sohbet turu, tick adımı).
  operationId String?
  // Çağrı başına benzersiz: aynı yanıt iki kez yazılamaz.
  callId      String  @unique

  // TEXT | IMAGE | SEARCH | EMBED | VIDEO
  kind     String
  purpose  String
  // openai | fal
  provider String
  model    String

  inputTokens    Int?
  outputTokens   Int?
  cachedTokens   Int?
  webSearchCalls Int?
  // Görsel adedi gibi sayılabilir birim.
  units          Int?

  costMicros    BigInt
  // true: sağlayıcı kullanım döndürmedi ya da fiyat tahmini (gerçek maliyet değil).
  costEstimated Boolean
  success       Boolean
  errorCode     String?
  durationMs    Int
  // Fiyat tablosu sürümü (reasoning-pricing.ts PRICE_TABLE_VERSION).
  priceTable    String

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([operationId])
  @@index([provider, createdAt])
}

// =============================================================================
// ABONELİK ve KULLANIM HAKLARI (~/.claude/plans/billing-usage-plan.md, Faz 2)
// =============================================================================
// Hiçbiri başka tabloya yabancı anahtarla bağlı DEĞİL (UsageEntry gibi düz
// workspaceId) ve hiçbirinde `projectId` adlı kolon YOK: ProjectDeletionService
// `projectId` kolonlu her tabloyu siler, faturalama kayıtları marka silinince
// gitmemeli. Para/kota sayaçları BigInt (görsel adedi; AI bütçesi mikro-dolar).
// Durum alanları String + migration'daki CHECK (enum değil: yeni durum eklemek
// ALTER TYPE gerektirmesin). Plan tanımı veritabanında DEĞİL: src/lib/billing/plans.ts.

// Workspace başına en çok bir abonelik: sağlayıcının (Stripe, Faz 4) aynası.
// Hak kararı `paidThrough` / `trialEndsAt` / `legacyUntil` alanlarından verilir
// (src/lib/billing/entitlements-core.ts), sağlayıcı dönem alanlarından değil.
model Subscription {
  id          String @id @default(cuid())
  workspaceId String @unique

  // null: LEGACY (mevcut müşteri, plan seçmedi) ya da planı henüz seçmemiş deneme.
  planKey  String?
  // MONTH | YEAR (faturalama aralığı; KOTA her zaman aylık verilir)
  interval String?
  // LEGACY | TRIALING | ACTIVE | PAST_DUE | CANCELED
  status   String

  // Aylık kota pencerelerinin çapası (deneme başlangıcı ya da ilk ücretli dönem).
  quotaAnchor DateTime?
  // Ödenmiş süre: YALNIZ ödeme olayıyla ilerler (Faz 4). Yenileme gecikmesi payı
  // ve ödeme başarısızlığı ek süresi plans.ts sabitlerinden gelir.
  paidThrough DateTime?
  // Bir kez yazılır, hiç silinmez: "daha önce deneme aldı" = dolu.
  trialEndsAt DateTime?
  graceUntil  DateTime?
  legacyUntil DateTime?

  cancelAtPeriodEnd Boolean @default(false)
  // 1 = ilk ücretli FATURA dönemi (ilk ay kampanyası penceresi bundan türer).
  periodIndex       Int     @default(1)
  // İlk ay kampanya fiyatı kullanıldı mı (bonusla yığılmaz).
  introOffer        Boolean @default(false)

  // Zamanlanmış plan/aralık değişikliği (düşürme dönem sınırında uygulanır).
  pendingPlanKey     String?
  pendingInterval    String?
  pendingEffectiveAt DateTime?

  // İç/demo/ortak hesaplar için kalıcı tam erişim.
  exempt      Boolean   @default(false)
  endedAt     DateTime?
  // CANCELED | REFUNDED | CHARGEBACK | PAYMENT_FAILED | TRIAL_ENDED | LEGACY_ENDED
  endedReason String?

  // Geçerli Stripe aboneliği (Faz 4). YALNIZ ödeme olayı yazar (satırın varlığı
  // LEGACY/NO_SUBSCRIPTION kararını değiştirir); eski bir aboneliğin geç gelen olayı
  // yeni aboneliği ezmesin diye işleyiciler bu kimlikle eşleşmeyen olayı yok sayar.
  stripeSubscriptionId String? @unique
  // Abonelik canlı mı test modunda mı açıldı. Geliştirme süreçleri canlı veritabanını
  // paylaşır: test modunda açılmış bir bağ, aynı workspace'in gerçek (canlı) ödemesini
  // "çift abonelik" diye engellemesin, canlı ödeme onu değiştirsin.
  stripeLivemode       Boolean?
  // Satıra en son UYGULANAN Stripe anlık görüntüsünün okunma anı. Kilitten ÖNCE okunmuş
  // eski bir görüntü (durum/iptal bayrağı/plan) sonradan gelip yeni olanı ezmesin diye
  // yalnız bundan yeni görüntüler bu alanları değiştirir (ödeme ve iptal monotondur,
  // bu korumadan bağımsız uygulanır).
  stripeSyncedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Workspace ↔ Stripe müşterisi (Faz 4). Subscription satırından AYRI tutulur: müşteri
// Checkout açılırken oluşur, ama ödeme gelmeden Subscription satırı YAZILMAZ (satır
// varlığı hak kararını değiştirir: satırsız mevcut müşteri LEGACY sayılır, "Subscribe"a
// basması onu kilitlememeli). Düz workspaceId, projectId kolonu yok (marka silinince
// faturalama kaydı gitmez).
//
// Canlı ve test müşterisi AYRI satırlardır (workspace başına mod başına bir tane): paylaşılan
// veritabanında test anahtarıyla çalışan bir geliştirme süreci canlı eşlemeyi ezmesin.
model BillingCustomer {
  id               String   @id @default(cuid())
  workspaceId      String
  livemode         Boolean
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())

  @@unique([workspaceId, livemode])
}

// Parası iade edilen ya da itiraz (chargeback) edilen abonelik faturaları (Faz 4 inceleme
// düzeltmesi). Stripe faturayı "paid" bırakır (iade yalnız tahsilatı değiştirir): bu mezar
// taşı olmadan aynı faturanın yeniden işlenmesi (Checkout dönüş adresi, yeniden gönderilen
// olay, ödemeden ÖNCE işlenen iade) erişimi ve kotayı geri getirirdi. Fatura başına tek
// satır; ödeme durum makinesi bu faturayı "ödenmiş" saymaz.
model BillingReversal {
  id              String   @id @default(cuid())
  stripeInvoiceId String   @unique
  workspaceId     String
  // REFUNDED | CHARGEBACK
  reason          String
  createdAt       DateTime @default(now())

  @@index([workspaceId])
}

// Ödeme sağlayıcısı webhook gelen kutusu (Faz 4): imzası doğrulanan her olay işlenmeden
// ÖNCE buraya yazılır (olay kimliği tekildir: tekrar teslim ikinci kez işlenmez),
// sonra işlenir. Olay GÖVDESİ saklanmaz: işleyiciler nesneyi sağlayıcıdan güncel hâliyle
// okur (sıra bozuk teslim ve sürüm farkı etkilemez, kişisel veri tutulmaz); burada yalnız
// ne geldiği ve ne olduğu durur.
model BillingEvent {
  id          String    @id @default(cuid())
  // stripe
  provider    String
  eventId     String
  type        String
  // Olayın baktığı nesne (sub_… in_… cs_… ch_… dp_…).
  objectId    String?
  livemode    Boolean   @default(false)
  // İşleyicinin çözdüğü workspace (tenant eşleşmesi doğrulanınca).
  workspaceId String?
  // PENDING | PROCESSED | IGNORED | FAILED
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  // Kısa, sır içermeyen hata/özet (ör. "tenant-mismatch").
  note        String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@index([workspaceId, receivedAt])
}

// (workspace, birim) başına tek satır: iki havuz.
//   PERIOD: plan kotası (süreli promosyonlar da buraya, pencereyle söner), her
//           aylık pencerede sıfırlanır, periodEnd'de söner.
//   EXTRA : YALNIZ satın alınan ek paket, süresiz; iptalde silinmez, tam erişimde
//           harcanır.
// Harcama sırası PERIOD → EXTRA (önce eriyen). used > granted olabilir (gerçekleşen
// API maliyeti geri alınamaz: borç sonraki sıfırlamada affedilir). Sayaçlar
// TÜREVDİR: reserved = RESERVED rezervasyonların from* toplamı (süpürücü onarır).
model UsageBalance {
  id          String @id
  workspaceId String
  // IMAGE | VIDEO | AI_MICROS
  unit        String

  periodStart    DateTime?
  periodEnd      DateTime?
  periodGranted  BigInt    @default(0)
  periodUsed     BigInt    @default(0)
  periodReserved BigInt    @default(0)

  extraGranted   BigInt @default(0)
  extraUsed      BigInt @default(0)
  extraReserved  BigInt @default(0)

  updatedAt DateTime

  @@unique([workspaceId, unit])
  @@index([periodEnd])
}

// Görev başlamadan ayrılan maksimum hak. reservationKey iş değil DENEME bazlıdır
// (`${operationId}#${deneme}`): aynı denemenin yinelenen teslimi aynı satırı bulur,
// yeniden deneme yeni anahtar alır. Bakiye ve satır tek SQL ifadesinde yazılır.
model UsageReservation {
  id             String @id
  workspaceId    String
  unit           String
  reservationKey String
  // Aynı işin rezervasyonlarını ve UsageEntry satırlarını bağlar (mutabakat);
  // tekil DEĞİL: tekillik reservationKey'dedir.
  operationId    String?
  amount         BigInt
  fromPeriod     BigInt @default(0)
  fromExtra      BigInt @default(0)
  // RESERVED | SETTLED | RELEASED
  status         String
  settledAmount  BigInt?
  // Gölge modda bakiye yetmediği halde izin verildi (sayaçlara dokunulmadı).
  overdraft      Boolean @default(false)
  // Çökmüş işin tuttuğu hak süpürücüyle geri verilir.
  expiresAt      DateTime
  createdAt      DateTime
  settledAt      DateTime?

  @@unique([workspaceId, unit, reservationKey])
  @@index([status, expiresAt])
  @@index([workspaceId, operationId])
}

// Bakiyeye eklenen her hakkın değişmez kaydı. Webhook/satın alma tekrarı çift hak
// vermesin: (workspaceId, idempotencyKey, unit, reason) tektir (aynı fatura iki
// birimi ve plan + bonus gibi iki nedeni birden verebilir). amount işaretlidir
// (iade/chargeback ters kaydı Faz 4-5).
model UsageGrant {
  id             String    @id
  workspaceId    String
  unit           String
  // PERIOD | EXTRA
  pool           String
  amount         BigInt
  // PLAN | PLAN_CHANGE | TRIAL | BONUS | REFERRAL | PURCHASE | ADJUST | REFUND
  reason         String
  idempotencyKey String
  // pool=PERIOD için hibenin ait olduğu pencerenin başlangıcı.
  periodStart    DateTime?
  reverses       String?
  createdAt      DateTime

  @@unique([workspaceId, idempotencyKey, unit, reason])
  @@index([workspaceId, createdAt])
}

model ReasoningCall {
  id          String  @id @default(cuid())
  workspaceId String
  projectId   String?
  brandId     String?

  purpose String
  model   String
  isMock  Boolean

  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  durationMs   Int

  status       String
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([purpose])
  // Scanners: a project's latest call of one purpose.
  @@index([projectId, purpose, createdAt])
}

// =============================================================================
// META ADS (docs/meta-ads-plan.md §4)
// =============================================================================
// Yeni reklam tabloları `Ads*` önekini ve `platform` alanını taşır (şimdilik
// yalnız META). Para alanları reklam hesabının minor unit'idir
// (src/lib/ads/money.ts). Tablolar düz `projectId` taşır; ProjectDeletionService
// onları kendiliğinden siler.

enum AdsPlatform {
  META
}

enum AdsOperationStatus {
  PENDING
  SENT
  SUCCEEDED
  UNKNOWN
  RECONCILED
  FAILED
  COMPENSATED
}

// Workspace'te bağlı bir Meta reklam hesabının tek kaydı: sağlık, kota ve
// senkron durumu. Meta kotası reklam hesabı (`act_`) başınadır; aynı hesap
// birden çok projeye bağlıysa satır tektir, projeler AdsAccountProject'tedir.
model AdsAccount {
  id           String      @id @default(cuid())
  workspaceId  String
  credentialId String?
  platform     AdsPlatform @default(META)
  // "act_<id>"
  externalId   String
  name         String?
  currency     String?
  timezoneName String?

  // Meta account_status (1 = ACTIVE) ve disable_reason (0 = yok).
  accountStatus Int?
  disableReason Int?
  hasFunding    Boolean?
  isPersonal    Boolean?

  spendCapMinor            BigInt?
  amountSpentMinor         BigInt?
  minDailyBudgetMinor      BigInt?
  minCampaignSpendCapMinor BigInt?
  minimumBudgets           Json?
  userTasks                String[] @default([])
  businessId               String?
  pageId                   String?
  instagramUserId          String?
  dsaBeneficiary           String?
  dsaPayor                 String?
  // development_access / standard_access (başlıktan okunur).
  accessTier               String?

  // Governor (src/server/integrations/meta/governor.ts): Meta'nın kullanım
  // başlıklarından son okunan değerler ve blok süresi. Durum süreçte değil
  // burada tutulur: deploy örtüşmesindeki iki kopya aynı kovayı görür.
  lastUsage        Json?
  rateLimitedUntil DateTime?

  // OK | WARN | BLOCKED | AUTH | UNKNOWN
  healthStatus String    @default("UNKNOWN")
  healthReason String?
  lastHealthAt DateTime?

  lastStructureAt     DateTime?
  lastInsightsAt      DateTime?
  lastBackfillDate    String?
  syncLeaseUntil      DateTime?
  syncLeaseOwner      String?
  consecutiveFailures Int       @default(0)

  // Webhook aboneliği (F7): SUBSCRIBED | POLLING_ONLY (hesabın admin
  // token'ı yok) | FAILED; null = denenmedi. Yoklama her durumda yedektir.
  webhookStatus    String?
  webhookCheckedAt DateTime?
  lastWebhookAt    DateTime?
  // Ad Rules sigortası (F7, isteğe bağlı): adrules_history son okuması.
  rulesHistoryAt   DateTime?
  // F8: hesabın geldiği workspace bağlantısı (FLfB / BISU); null = proje
  // bağlantısı (kullanıcı token'ı).
  connectionId     String?
  // F8 async insights: bekleyen rapor işleri ve günlük sayaç
  // ({ day, started, runs: [{ id, level, since, until, createdAt }] }).
  asyncInsights    Json?

  projects AdsAccountProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, platform, externalId])
  @@index([externalId])
  @@index([syncLeaseUntil])
  @@index([connectionId])
}

// Hesap ↔ proje bağlantısı. v1'de proje başına tek seçili hesap (K10);
// tablo çoklu hesaba hazırdır.
model AdsAccountProject {
  id           String     @id @default(cuid())
  adsAccountId String
  projectId    String
  brandId      String
  selected     Boolean    @default(false)
  adsAccount   AdsAccount @relation(fields: [adsAccountId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([adsAccountId, projectId])
  @@index([projectId, selected])
}

// Her Meta yazmasının niyet ve denetim kaydı (docs/meta-ads-plan.md §3.1
// Idempotency). Meta istemci tarafı idempotency anahtarı sunmaz: yazmadan önce
// bu satır açılır, `tag` nesne adına eklenir; zaman aşımında kör tekrar
// yapılmaz, önce etiketle Meta'da aranır. Token asla saklanmaz.
model AdsOperation {
  id                  String             @id @default(cuid())
  workspaceId         String
  projectId           String
  adsAccountId        String?
  // "act_<id>": kota ve uzlaştırma için.
  adAccountExternalId String?
  // CREATE_CAMPAIGN, CREATE_ADSET, CREATE_CREATIVE, CREATE_AD, UPDATE_CAMPAIGN,
  // UPDATE_ADSET, UPDATE_AD, SET_STATUS...
  kind                String
  // "agx:k3f9q2" — Meta'da uzlaştırma anahtarı.
  tag                 String             @unique
  launchId            String?
  decisionId          String?
  executionJobId      String?
  // USER | SYSTEM | RULE
  actorType           String
  // Yazmanın hedefi (güncellemede nesne, oluşturmada ebeveyn kenarı).
  targetExternalId    String?
  parentExternalId    String?
  request             Json
  previousState       Json?
  status              AdsOperationStatus @default(PENDING)
  resultExternalId    String?
  // code, subcode, class, userMessage, blameFieldSpecs, fbtraceId
  error               Json?
  attempts            Int                @default(0)
  sentAt              DateTime?
  completedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([executionJobId, kind])
  @@index([projectId, createdAt])
  @@index([status, sentAt])
  @@index([adAccountExternalId, createdAt])
}

enum AdsLevel {
  ACCOUNT
  CAMPAIGN
  ADSET
  AD
}

enum AdsAlertStatus {
  OPEN
  ACKED
  RESOLVED
  MUTED
}

enum AdsSeverity {
  INFO
  WARN
  CRITICAL
}

// Kampanya / ad set / reklam aynası (docs/meta-ads-plan.md §3.2). Ekranlar,
// sohbet ve kurallar canlı Graph yerine buradan okur. `goneAt`: Meta listesinde
// artık görünmeyen (arşivlenmiş ya da silinmiş) nesne; harcaması kimlikle
// okunmaya devam eder.
model AdsObject {
  id                   String    @id @default(cuid())
  adsAccountId         String
  projectId            String?
  level                AdsLevel
  externalId           String
  parentExternalId     String?
  campaignExternalId   String?
  name                 String
  objective            String?
  optimizationGoal     String?
  billingEvent         String?
  bidStrategy          String?
  destinationType      String?
  configuredStatus     String?
  effectiveStatus      String?
  dailyBudgetMinor     BigInt?
  lifetimeBudgetMinor  BigInt?
  spendCapMinor        BigInt?
  budgetRemainingMinor BigInt?
  startTime            DateTime?
  endTime              DateTime?
  learningStatus       String?
  learningConversions  Int?
  lastSigEditAt        DateTime?
  issues               Json?
  reviewFeedback       Json?
  failedDeliveryChecks Json?
  advantageState       String?
  // F8 kitle çakışması: hedeflemenin özeti (ülkeler, yaş, cinsiyet, özel
  // kitleler); kişisel veri yok.
  targeting            Json?
  resultActionType     String?
  creativeExternalId   String?
  thumbnailAssetId     String?
  thumbnailFetchedAt   DateTime?
  // 7 ve 28 günlük tekil kişi metrikleri (erişim, sıklık); günlük satırlardan
  // toplanamaz.
  windowStats          Json?
  createdByAgentelse   Boolean   @default(false)
  launchId             String?
  // İzlenen alanların özeti: değişirse drift denetlenir.
  fieldsHash           String?
  metaUpdatedAt        DateTime?
  lastSeenAt           DateTime?
  lastDeliveryAt       DateTime?
  driftAt              DateTime?
  goneAt               DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([adsAccountId, externalId])
  @@index([projectId, level, effectiveStatus])
  @@index([adsAccountId, level])
}

// Günlük performans (hesap gününe göre). Para alanları hesabın minor
// unit'idir. Reklam düzeyi 180 gün, diğer düzeyler 400 gün saklanır (K7).
model AdsInsightDaily {
  id                 String   @id @default(cuid())
  adsAccountId       String
  projectId          String?
  level              AdsLevel
  // ACCOUNT için "act_<id>"
  externalId         String
  date               DateTime @db.Date
  spendMinor         BigInt   @default(0)
  impressions        Int      @default(0)
  reach              Int      @default(0)
  frequency          Float?
  clicks             Int      @default(0)
  linkClicks         Int      @default(0)
  landingPageViews   Int      @default(0)
  // Meta'nın `results` alanından (ya da hedefe göre yedek eşlemeden).
  results            Int?
  resultActionType   String?
  actionValuesMinor  BigInt?
  actions            Json?
  video3s            Int?
  thruplays          Int?
  rankings           Json?
  attributionSetting String?
  // 28 günden eski satır artık yeniden çekilmez.
  isFinal            Boolean  @default(false)
  fetchedAt          DateTime @default(now())

  @@unique([adsAccountId, level, externalId, date])
  @@index([projectId, date])
  @@index([adsAccountId, date])
}

// Tekilleştirilmiş reklam uyarısı (docs/meta-ads-plan.md §3.6). Koşul tekrar
// ederse aynı satır yeniden açılır; düzelince kendiliğinden RESOLVED olur.
// LLM puanlamasından geçmez.
model AdsAlert {
  id             String         @id @default(cuid())
  workspaceId    String
  projectId      String
  adsAccountId   String?
  externalId     String?
  kind           String
  severity       AdsSeverity
  status         AdsAlertStatus @default(OPEN)
  dedupeKey      String
  // Ortak uyarı tablosu (GK8): null = Meta Ads; "GA4" | "GSC" | "SEO"
  // (src/server/monitoring/site-alerts.ts).
  source         String?
  title          String
  detail         String?
  data           Json?
  firstSeenAt    DateTime       @default(now())
  lastSeenAt     DateTime       @default(now())
  occurrences    Int            @default(1)
  notifiedAt     DateTime?
  notifyChannels String[]       @default([])
  mutedUntil     DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([projectId, dedupeKey])
  @@index([projectId, status, severity])
  @@index([projectId, source, status])
}

// Lansman durumu (docs/meta-ads-plan.md §3.4).
enum AdsLaunchStatus {
  DRAFT
  MEDIA_PROCESSING
  VALIDATED
  AWAITING_APPROVAL
  CREATING
  CREATED_PAUSED
  ACTIVATING
  ACTIVE
  FAILED
  EXPIRED
  CANCELLED
  DISCARDING
  DISCARDED
}

// Bir lansmanın tek kaydı (F3). Kart yalnız launchId tutar; durum, ilerleme
// (kurulan nesnelerin kimlikleri) ve Meta'nın ön kontrol sonuçları buradadır.
// Her deneme ("Fix and retry", "Turn on", "Discard") ayrı bir META_LAUNCH
// görevidir ve aynı kayda bağlanır; başarılı adımlar niyet günlüğünden
// (AdsOperation.launchId) bulunup atlanır.
model AdsLaunch {
  id                   String          @id @default(cuid())
  workspaceId          String
  projectId            String
  workId               String?
  // Lansmanı açan kartın Command'ı.
  commandId            String
  launchKey            String
  adsAccountId         String?
  adAccountExternalId  String
  status               AdsLaunchStatus @default(DRAFT)
  specVersion          Int             @default(1)
  spec                 Json
  // Onayın geçerliliği: bütçe, hedefleme, amaç ya da kimlik değişirse değişir.
  specHash             String
  // Yerel doğrulama, Meta validate_only sonuçları ve önizlemeler.
  validation           Json?
  approvalId           String?
  activationApprovalId String?
  currentTaskId        String?
  // create | activate | discard
  mode                 String?
  campaignExternalId   String?
  // Adım sonuçları: görsel hash'leri, kreatif / ad set / reklam kimlikleri.
  progress             Json?
  envelope             Json?
  // Meta tarafı frenler: kampanya spend_cap, ad set end_time (geri okunmuş).
  guards               Json?
  error                Json?
  // Adım makinesinin kilidi: işçi ve satır içi sürüş aynı anda yazmaz.
  leaseUntil           DateTime?
  leaseOwner           String?
  createdByUserId      String?
  activatedAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([commandId, launchKey])
  @@index([projectId, status])
  @@index([status, updatedAt])
}

// Optimizasyon kararının durumu (docs/meta-ads-plan.md §3.5).
enum AdsDecisionStatus {
  SHADOW
  PROPOSED
  APPROVED
  REJECTED
  EXPIRED
  SUPERSEDED
  APPLYING
  APPLIED
  VERIFIED
  FAILED
  ROLLED_BACK
}

// Reklam otonomisi (F7): Suggest (öneri), Guarded (yalnız riski azaltan
// otomatik), Full (zarf içinde otomatik).
enum AdsAutonomyLevel {
  SUGGEST
  GUARDED
  FULL
}

// Optimizasyon karar kaydı (F4): her değişiklik öneri → onay → uygulama →
// geri okuma → değerlendirme → geri alma zincirini izler. Gölge modda yalnız
// SHADOW yazılır. Kurallar deterministiktir; metin yalnız açıklamadır.
model AdsDecision {
  id            String            @id @default(cuid())
  workspaceId   String
  projectId     String
  adsAccountId  String
  level         AdsLevel
  externalId    String
  // "O2_HIGH_CPA"
  ruleKey       String
  ruleVersion   Int
  // PAUSE, BUDGET_DOWN, BUDGET_UP, CREATIVE_REFRESH, ARCHIVE, NOTIFY, ROLLBACK
  kind          String
  severity      AdsSeverity
  status        AdsDecisionStatus
  autonomy      AdsAutonomyLevel  @default(SUGGEST)
  // Pencereler, metrikler, geçen kapılar.
  evidence      Json
  explanation   String
  // { field, from, to }: "from" uygulamada CAS için.
  change        Json?
  // kural + nesne + hafta
  fingerprint   String            @unique
  approvalId    String?
  taskId        String?
  expiresAt     DateTime?
  appliedAt     DateTime?
  verifiedAt    DateTime?
  // Olgunluk gecikmesiyle değerlendirme zamanı.
  evaluateAfter DateTime?
  evaluatedAt   DateTime?
  // WORKED | DIDNT | INCONCLUSIVE
  outcome       String?
  outcomeData   Json?
  rollbackOfId  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([projectId, status])
  @@index([adsAccountId, externalId, ruleKey])
  @@index([status, evaluateAfter])
}

// Gelen Meta Ads webhook olayları (docs/meta-ads-plan.md F7): imza doğrulanınca
// yazılır ve hemen 200 dönülür; ajans tick'i 2 dk bekletip nesneyi hedefli
// okuyarak işler. Gövdede olay kimliği yok: dedupeKey = sha256(entry.id +
// entry.time + alan + nesne + değer). 5 denemeden sonra DEAD; 14 gün saklanır.
model AdsWebhookEvent {
  id                  String    @id @default(cuid())
  receivedAt          DateTime  @default(now())
  // "act_<id>"
  adAccountExternalId String
  field               String
  objectExternalId    String?
  objectLevel         String?
  payload             Json
  dedupeKey           String    @unique
  // PENDING | DONE | SKIPPED | DEAD
  status              String    @default("PENDING")
  attempts            Int       @default(0)
  leaseUntil          DateTime?
  lastError           String?
  processedAt         DateTime?

  @@index([status, receivedAt])
  @@index([receivedAt])
}

// Workspace düzeyinde Meta bağlantısı (docs/meta-ads-plan.md F8): Facebook
// Login for Business (config_id) ile alınan, kişiye bağlı olmayan BISU
// token'ı. Hesapları projelere atanır (proje bağlantısı bu token'ın
// kopyasını taşır). Token ayrı ve sürümlü anahtarla şifrelenir (keyId).
model AdsConnection {
  id                  String    @id @default(cuid())
  workspaceId         String
  // USER | BISU | SYSTEM_USER
  kind                String
  name                String?
  // Müşterinin business portfolio'su (/me?fields=client_business_id).
  clientBusinessId    String?
  encryptedSecret     String
  // META_TOKEN_KEYS içindeki anahtarın kimliği; "legacy" = ortak anahtar.
  keyId               String    @default("legacy")
  scopes              String[]  @default([])
  // null: süresiz (debug_token expires_at = 0).
  expiresAt           DateTime?
  dataAccessExpiresAt DateTime?
  // ACTIVE | EXPIRED | REVOKED
  status              String    @default("ACTIVE")
  lastCheckedAt       DateTime?
  createdByUserId     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([workspaceId])
}
