# Database (PostgreSQL; Neon is optional)
DATABASE_URL=
DIRECT_URL=

# Tests must use a separate, visibly test-only database. Never point this at
# the development/production database.
TEST_DATABASE_URL=
TEST_DIRECT_URL=

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenClaw — integrates as a CLI subprocess (`openclaw agent --json`), not an
# HTTP API. Leave OPENCLAW_CLI_PATH empty when using the explicit mock mode.
OPENCLAW_CLI_PATH=
# Only needed if your default `node` doesn't satisfy OpenClaw's engine range
# (>=22.22 <23, >=24.15 <25, or >=25.9) — points at a compatible Node binary
# used to run the CLI, e.g. /opt/homebrew/opt/node@24/bin/node
OPENCLAW_NODE_PATH=
OPENCLAW_DEFAULT_AGENT_ID=hubconnect
OPENCLAW_TIMEOUT_SECONDS=120
OPENCLAW_IMAGE_MODEL=openai/gpt-image-2

# AI providers
ANTHROPIC_API_KEY=
# Used by Agency OS structured reasoning when the mode is auto.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro-latest
# Reserved for a future direct OpenAI provider. OpenClaw manages its own
# image-provider credentials outside this application.
OPENAI_API_KEY=

# Safe local defaults. Remove/change these in production to require real
# configured providers; mock execution is never selected implicitly.
HUBCONNECT_PROVIDER_MODE=mock
HUBCONNECT_REASONING_MODE=mock

# Cloudflare R2 (reserved; the current adapter uses local disk storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Sentry (reserved; startup integration is not implemented yet)
SENTRY_DSN=

# Internal
CRON_SECRET=
# 64 hexadecimal characters (`openssl rand -hex 32`). Required before using
# OTP/MFA human-intervention flows.
TEMPORARY_SECRET_ENCRYPTION_KEY=
# Set true when another process/scheduler owns worker ticks.
DISABLE_LOCAL_WORKER=false
