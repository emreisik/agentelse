model HumanInterventionRequest {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  taskId           String?
  executionJobId   String?
  browserProfileId String?

  type   HumanInterventionType
  status HumanInterventionStatus @default(PENDING)

  title   String
  message String?

  inputType HumanInterventionInputType

  task             Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  executionJob     ExecutionJob?     @relation(fields: [executionJobId], references: [id], onDelete: SetNull)
