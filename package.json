{
  "name": "agentelse",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "dev:marketing": "npm run dev -w apps/marketing",
    "build:marketing": "npm run build -w apps/marketing",
    "db:seed": "tsx prisma/seed.ts",
