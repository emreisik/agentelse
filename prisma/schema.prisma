  // MetaCampaignChainRelay) so a MEASUREMENT_CHECK task has a concrete
  // target to actually check instead of just this plan's internal id.
  platform       SocialPlatform?
  postUrl        String?
  platformPostId String?
  campaignId     String?

  checks MeasurementCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
