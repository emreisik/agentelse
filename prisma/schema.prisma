model TemporarySecret {
  id                         String @id @default(cuid())
  workspaceId                String
  humanInterventionRequestId String

  encryptedValue String

  humanInterventionRequest HumanInterventionRequest @relation(fields: [humanInterventionRequestId], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  consumedAt DateTime?

