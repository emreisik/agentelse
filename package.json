    "db:seed:agency": "tsx prisma/dev-seed-agency.ts",
    "assets:migrate-to-r2": "tsx prisma/migrate-assets-to-r2.ts",
    "db:reset:agency": "tsx prisma/reset-agency.ts",
    "db:backfill:posts": "tsx prisma/backfill-posts.ts",
    "db:report:backlog": "tsx prisma/worker-backlog-report.ts",
    "db:report:cost": "tsx prisma/cost-report.ts",
    "db:report:ga-forecast": "tsx prisma/ga-forecast-backtest.ts",
    "db:backfill:approval-expiry": "tsx prisma/backfill-approval-expiry.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.14",
    "@assistant-ui/react-markdown": "^0.14.10",
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1114.0",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cron-parser": "^5.7.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "openai": "^7.23.0",
    "prisma": "^6.19.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.2",
