model BrandLearning {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  insight    String
  sourceType String?
  sourceRef  String?
  confidence Float?

  // Brand Workspace's Creative Memory ("what works" / "avoid" — see
  // docs/brand-workspace-migration.md §7 Phase 3): WORKS/AVOID lets the
  // same table serve both sides of that list. A single observation must
  // not silently become a permanent rule — evidenceCount is incremented
  // (not a new row inserted) when a materially similar insight is
  // reobserved, so a learning only counts as reinforced once multiple
  // evidence points agree.
  polarity         LearningPolarity @default(WORKS)
  evidenceCount    Int              @default(1)
  lastReinforcedAt DateTime?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([brandId])
  // Learning engine: a lesson by its source.
  @@index([sourceType, sourceRef])
}

// Brand Workspace's structured preference/decision log (see docs/
// brand-workspace-migration.md §7 Phase 3) — captures a user statement like
// "more premium" as a typed, queryable fact (type/scope/value) instead of
// leaving it recoverable only by re-reading raw chat history. Deliberately
// separate from BrandDecision (agency-authored strategic decisions) and
// AgencyDecision (settings-panel decisions) — this one is always
// user-authored preference/confirmation, scoped freely (e.g. "BRAND",
// "CAMPAIGN:<id>") rather than tied to one entity type.
model UserDecision {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  type  UserDecisionType
  scope String
  value Json

  // The message this was derived from is always kept alongside the
  // structured value — per spec: "Keep the raw conversation message too."
  rawMessage      String?
  sourceCommandId String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([projectId])
  @@index([brandId, type])
}

model BrandStrategyVersion {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  version         Int
  summary         String?
  payload         Json
  createdByUserId String?

  createdAt DateTime @default(now())

  @@unique([brandId, version])
  @@index([projectId])
  @@index([brandId])
}

model BrandEvidence {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  evidenceId        String
  relatedEntityType String
  relatedEntityId   String

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([brandId])
  @@index([relatedEntityType, relatedEntityId])
}

// =============================================================================
// CONTEXT SNAPSHOT
// =============================================================================

model ExecutionContextSnapshot {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  brandBrainVersion    Int?
  strategyVersion      Int?
  negativeBriefVersion Int?

  payload Json
  hash    String

  executionJobs ExecutionJob[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
}

// =============================================================================
// COMMAND / TASK / EXECUTION
// =============================================================================

// One conversation of the Agency Desk (docs/works.md): a titled, channel-scoped
// piece of work the user opens, continues and completes. Chat rows (Command)
// belong to a Work through Command.workId; rows without one are the legacy
// single project chat. Connection status is NOT stored here (it is read live);
// only the channels the user chose to work on.
model Work {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  createdByUserId String?

  title   String
  // One-line subtitle: the newest card's summary.
  summary String?
  status  WorkStatus @default(ACTIVE)

  // Chosen channel keys (content-channels CHANNEL_KEYS subset), e.g. ["instagram"].
  channels Json @default("[]")
  // Channel keys chosen while NOT connected ("I'll connect later").
  acknowledgedUnconnected Json @default("[]")

  // The module this Work is for (src/lib/modules/catalog.ts: "social", "ads",
  // "analytics", "seo"). Null = a general chat. A plain string validated in
  // the app, like Creative.channel.
  module String?

  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  commands Command[]
  posts    Post[]

  @@index([projectId, status, lastActivityAt])
  @@index([workspaceId])
}

// One post: ONE idea and ONE picture, delivered to channels (docs/works.md
// "Posts"). Each channel's piece is a Creative with this postId (its
// delivery): its own format, caption, approval and publish state, so the
// publishing code keeps working per delivery. The post's own state is derived
// from its deliveries; only the post-level decisions are stored here.
model Post {
  id          String  @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String
  workId      String?
  // The plan's chat Command (same as Creative.planId, no FK); the pool idea.
  planId      String?
  ideaId      String?

  // THE idea, and its caption idea / master message.
  topic String
  idea  String?
  goal  String?

  // When it goes out (its deliveries carry the same instant), and the zone
  // the plan was drawn in.
  scheduledFor DateTime?
  timezone     String?

  // THE picture: the first one rendered for the post; every other image
  // delivery is this picture adapted to its own format.
  pictureAssetId String?

  approvedAt       DateTime?
  approvedByUserId String?
  archivedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  work       Work?      @relation(fields: [workId], references: [id], onDelete: SetNull)
  deliveries Creative[]

  @@index([projectId, scheduledFor])
  @@index([planId])
  @@index([workId])
}

model Command {
  id          String  @id @default(cuid())
  workspaceId String
  projectId   String?
  brandId     String?
  // Populated when a message belongs to an idea's own chat thread — both
  // the messages the user writes about that idea (source: WEB) and the
  // system messages the agency pipeline (council, work plan, task/creative
  // completion) writes into that idea's thread (source: SYSTEM) accumulate
  // here under the same ideaId — the "everything in one conversation"
  // architecture.
  ideaId      String?
  // A non-idea, non-project-general conversation scope — currently only
  // "BRAND_BRAIN" (brand-brain-chat-service.ts), a project-wide but
  // brand-strategy-focused thread distinct from both an idea's chat and the
  // general project chat (which explicitly excludes topic != null rows, see
  // projects/[projectId]/page.tsx, so the two streams never mix). Kept as a
  // free string rather than an enum so a future second topic doesn't need a
  // migration.
  topic       String?

  source          CommandSource
  rawText         String
  parsedIntent    Json?
  createdByUserId String?

  // Chat turn: files the user attached and the assistant's reply for that
  // turn. attachments = [{ assetId, filename, mimeType, size }].
  attachments Json?
  replyText   String?
  replyStatus String?

  // The Work (conversation) this row belongs to; null = legacy single chat.
  workId String?
  work   Work?   @relation(fields: [workId], references: [id], onDelete: SetNull)

  idea  Idea?  @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  tasks Task[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([projectId])
  @@index([createdAt])
  @@index([ideaId])
  @@index([workId, createdAt])
  @@index([topic])
  // Single-chat consolidation: the general-chat query is no longer narrowed
  // by ideaId (it now includes every SYSTEM pipeline event project-wide,
  // not just idea-less ones — see chat-service.ts buildContext / page.tsx),
  // so it needs its own composite index instead of relying on the
  // ideaId-narrowed query being naturally selective.
  @@index([projectId, createdAt])
  // The chat page reads WEB and SYSTEM rows separately, newest first.
  @@index([projectId, source, createdAt])
}

model Task {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  commandId    String?
  parentTaskId String?

  title       String
  description String?
  // Original command payload (e.g. { request, platform }) — persisted so a
  // task parked behind an Approval can be re-dispatched with the same
  // request details once approved, instead of guessing them from the title.
  payload     Json?

  capability CapabilityKey

  status    TaskStatus   @default(DRAFT)
  priority  TaskPriority @default(MEDIUM)
  riskLevel RiskLevel    @default(LOW)

  createdByType   ActorType
  createdByUserId String?

  requiresApproval     Boolean @default(false)
  requiresVerification Boolean @default(false)

  // Agency OS additions: which department owns this work, which WorkPlan it
  // belongs to, which ProjectGoals it serves, and a dedup fingerprint so the
  // director can refuse to recreate the same work inside a cooldown window.
  departmentKey    DepartmentKey?
  workPlanId       String?
  goalIds          String[]       @default([])
  fingerprint      String?
  sourceDecisionId String?

  command            Command?                   @relation(fields: [commandId], references: [id], onDelete: SetNull)
  parentTask         Task?                      @relation("TaskChildren", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks         Task[]                     @relation("TaskChildren")
  dependsOn          TaskDependency[]           @relation("TaskDependent")
  dependedOnBy       TaskDependency[]           @relation("TaskDependsOn")
  executionJobs      ExecutionJob[]
  approvals          Approval[]
  humanInterventions HumanInterventionRequest[]
  creatives          Creative[]
  workPlan           WorkPlan?                  @relation(fields: [workPlanId], references: [id], onDelete: SetNull)

  dueAt       DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
  @@index([status])
  @@index([capability])
  @@index([createdAt])
  @@index([projectId, status])
  @@index([projectId, fingerprint, createdAt])
  @@index([workPlanId])
  // Plan/package pieces by their plan Command (chat page, journey, plan routes).
  @@index([commandId])
  // Publish tasks per project and window (calendar poll, publish paths).
  @@index([projectId, capability, createdAt])
  @@index([parentTaskId])
  // The chat's progress poll: did any task of the project change since the
  // page was rendered (src/server/chat/progress.ts).
  @@index([projectId, updatedAt])
}

model TaskDependency {
  id              String @id @default(cuid())
  taskId          String
  dependsOnTaskId String

  task          Task @relation("TaskDependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("TaskDependsOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
}

model ExecutionJob {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String
  taskId      String

  capability   CapabilityKey
  providerType ExecutionProviderType
  providerId   String?

  skillId      String?
  skillVersion String?

  browserProfileId String?

  phase  OperationPhase     @default(ACT)
  status ExecutionJobStatus @default(QUEUED)

  correlationId  String @unique
  idempotencyKey String @unique

  // Opaque handle returned by the provider's execute() call, used to poll
  // getStatus()/cancel()/resume() later. Not always equal to correlationId —
  // real providers may mint their own reference.
  providerExecutionReference String?

  contextSnapshotId String?

  requestPayload   Json?
  rawResult        Json?
  normalizedResult Json?

  errorCode    String?
  errorMessage String?
  retryable    Boolean @default(false)

  attemptCount Int @default(0)

  estimatedCost Float?
  actualCost    Float?

  task               Task                       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  browserProfile     BrowserProfile?            @relation(fields: [browserProfileId], references: [id], onDelete: SetNull)
  contextSnapshot    ExecutionContextSnapshot?  @relation(fields: [contextSnapshotId], references: [id], onDelete: SetNull)
  skill              Skill?                     @relation(fields: [skillId], references: [id], onDelete: SetNull)
  outboxEvents       OutboxEvent[]
  deadLetterJobs     DeadLetterJob[]
  verification       ExecutionVerification?
  evidences          Evidence[]
  humanInterventions HumanInterventionRequest[]

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
  @@index([status])
  @@index([capability])
  @@index([createdAt])
  @@index([taskId])
  // Provider health: each provider's results in the last window.
  @@index([providerId, updatedAt])
}

// =============================================================================
// PROVIDER HEALTH
// =============================================================================

model ProviderDefinition {
  id           String                @id @default(cuid())
  key          String                @unique
  name         String
  providerType ExecutionProviderType
  configured   Boolean               @default(false)

  health    ProviderHealth?
  incidents ProviderIncident[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProviderHealth {
  id               String               @id @default(cuid())
  providerId       String               @unique
  status           ProviderHealthStatus @default(UNAVAILABLE)
  lastCheckAt      DateTime?
  lastErrorMessage String?

  provider ProviderDefinition @relation(fields: [providerId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

model ProviderIncident {
  id         String  @id @default(cuid())
  providerId String
  message    String
  resolved   Boolean @default(false)

  provider ProviderDefinition @relation(fields: [providerId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([providerId])
}

// =============================================================================
// HUMAN INTERVENTION / TEMPORARY SECRET / APPROVAL
// =============================================================================

model HumanInterventionRequest {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  taskId           String?
  executionJobId   String?
  browserProfileId String?

  type   HumanInterventionType
  status HumanInterventionStatus @default(PENDING)

  title   String
  message String?

  inputType HumanInterventionInputType

  task             Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  executionJob     ExecutionJob?     @relation(fields: [executionJobId], references: [id], onDelete: SetNull)
  browserProfile   BrowserProfile?   @relation(fields: [browserProfileId], references: [id], onDelete: SetNull)
  temporarySecrets TemporarySecret[]

  expiresAt        DateTime
  resolvedAt       DateTime?
  resolvedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
  @@index([status])
  @@index([createdAt])
  @@index([taskId])
  @@index([executionJobId])
}

// Ephemeral secret store for OTP/MFA codes. Never referenced from Task
// description, ExecutionJob payloads, or AuditLog metadata. A background
// sweep deletes rows past expiresAt; consumedAt marks single-use spend.
model TemporarySecret {
  id                         String @id @default(cuid())
  workspaceId                String
  humanInterventionRequestId String

  encryptedValue String

  humanInterventionRequest HumanInterventionRequest @relation(fields: [humanInterventionRequestId], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([humanInterventionRequestId])
}

model Approval {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  taskId String?

  entityType String
  entityId   String

  type   ApprovalType
  status ApprovalStatus @default(PENDING)

  // Agency OS approval level. Null = legacy row, treated as LEVEL_3_CLIENT.
  level ApprovalLevel?

  requestedByType ActorType
  requestedById   String?

  reviewedByUserId String?
  reviewNote       String?

  // ID of the approval request message in Telegram — used to remove the
  // buttons and update the message after a decision is made.
  telegramMessageId String?

  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
  @@index([status])
  @@index([entityType, entityId])
  // Open approvals of a project, oldest first (every chat page and turn).
  @@index([projectId, status, createdAt])
  @@index([taskId])
}

// =============================================================================
// CREATIVE WORKFLOW / ASSETS
// =============================================================================

model Asset {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  type     AssetType
  source   AssetSource @default(AI_GENERATED)
  filename String
  mimeType String

  storageKey String
  size       Int
  hash       String?

  // Real pixel dimensions — measured with sharp at write time (AI-generated
  // creative images: src/server/media/creative-image.ts; user uploads:
  // library-actions.ts). Null for videos/documents and for rows created
  // before this field existed.
  width  Int?
  height Int?

  creativeVersions CreativeVersion[]
  evidences        Evidence[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
  // Newest files of a project (right panel Files, Library).
  @@index([projectId, createdAt])
}

model Creative {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  type     CreativeType
  platform SocialPlatform?

  title String?
  brief String?

  status           CreativeStatus @default(DRAFT)
  currentVersionId String?

  createdByTaskId String?

  createdByTask Task?             @relation(fields: [createdByTaskId], references: [id], onDelete: SetNull)
  versions      CreativeVersion[] @relation("CreativeVersions")

  // Content calendar's day+time assignment (spec: takvim) — a specific
  // publish instant (UTC), not just a day: the calendar UI lets the user
  // pick both. Converted from/to the project's configured timezone (see
  // ProjectSchedule.timezone) via src/lib/timezone.ts, since a bare
  // datetime-local form value has no timezone of its own. The Instagram
  // publish queue (approval-decisions.ts) treats this as "due" once it's
  // in the past; unscheduled creatives keep the old FIFO behavior.
  scheduledFor DateTime?

  // Where and in what shape this piece is meant to go out, set when it
  // comes from a content plan (src/lib/content-channels.ts holds the
  // catalog: channel "instagram", formatKey "instagram.carousel"). Plain
  // strings validated in the app so new channels need no migration; null on
  // everything created outside a plan. `planId` groups the items saved from
  // one plan (the chat Command that drafted it); `goal` is the plan's
  // purpose (awareness/leads/sales/engagement/traffic).
  channel   String?
  formatKey String?
  goal      String?
  planId    String?

  // The post this piece is a channel delivery of (null: a piece on its own,
  // treated as a post of one). `excludedAt`: the channel was left out of the
  // post (undoable, unlike ARCHIVED); an excluded delivery is never made,
  // approved or published.
  postId     String?
  post       Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  excludedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
  @@index([status])
  @@index([projectId, scheduledFor])
  @@index([projectId, channel])
  @@index([planId])
  @@index([postId])
  @@index([createdByTaskId])
  // The chat's progress poll (src/server/chat/progress.ts).
  @@index([projectId, updatedAt])
}

model CreativeVersion {
  id         String @id @default(cuid())
  creativeId String

  version Int

  assetId String?
  caption String?
  copy    String?

  // Which platform × content-type slot this version was generated for
  // (see src/lib/creative-platform-format.ts) — null for older rows and
  // for versions with no platform (creative.platform is also optional).
  contentFormat CreativeContentFormat?

  generationProvider String?
  generationMetadata Json?

  revisionReason String?

  creative Creative @relation("CreativeVersions", fields: [creativeId], references: [id], onDelete: Cascade)
  asset    Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([creativeId, version])
  @@index([creativeId])
}

// =============================================================================
// EVIDENCE / VERIFICATION
// =============================================================================

model Evidence {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  executionJobId String?

  sourceType EvidenceSourceType

  sourceUrl String?
  pageTitle String?

  assetId String?

  statement       String?
  extractedText   String?
  confidenceScore Float?

  accessedAt  DateTime?
  contentHash String?

  executionJob   ExecutionJob?   @relation(fields: [executionJobId], references: [id], onDelete: SetNull)
  asset          Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  brandEvidences BrandEvidence[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
  @@index([executionJobId])
}

model ExecutionVerification {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  executionJobId String @unique

  status ExecutionVerificationStatus @default(PENDING)

  expectedState Json?
  observedState Json?
  evidenceIds   String[]

  executionJob ExecutionJob @relation(fields: [executionJobId], references: [id], onDelete: Cascade)

  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([projectId])
  @@index([status])
}

// =============================================================================
// COMPETITOR INTELLIGENCE
// =============================================================================

model Competitor {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  name   String
  domain String?
  notes  String?

  sources   CompetitorSource[]
  snapshots CompetitorSnapshot[]
  changes   CompetitorChange[]
  insights  CompetitorInsight[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([brandId])
}

model CompetitorSource {
  id           String @id @default(cuid())
  competitorId String

  sourceType String
  url        String

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([competitorId])
}

model CompetitorSnapshot {
  id           String @id @default(cuid())
  competitorId String

  capturedAt  DateTime
  payload     Json
  contentHash String

  competitor  Competitor         @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  changesFrom CompetitorChange[] @relation("ChangeFromSnapshot")
  changesTo   CompetitorChange[] @relation("ChangeToSnapshot")

  createdAt DateTime @default(now())

  @@index([competitorId])
  @@index([capturedAt])
}

model CompetitorChange {
  id           String @id @default(cuid())
  competitorId String

  fromSnapshotId String?
  toSnapshotId   String

  summary String
  diff    Json?

  competitor   Competitor          @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  fromSnapshot CompetitorSnapshot? @relation("ChangeFromSnapshot", fields: [fromSnapshotId], references: [id], onDelete: SetNull)
  toSnapshot   CompetitorSnapshot  @relation("ChangeToSnapshot", fields: [toSnapshotId], references: [id], onDelete: Cascade)
  insights     CompetitorInsight[]

  createdAt DateTime @default(now())

  @@index([competitorId])
}

model CompetitorInsight {
  id           String  @id @default(cuid())
  competitorId String
  changeId     String?

  insight    String
  confidence Float?

  competitor Competitor        @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  change     CompetitorChange? @relation(fields: [changeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([competitorId])
}

// =============================================================================
// PRODUCT / OFFER SIGNALS
// =============================================================================
// Generic inbound capability: an external system (an e-commerce/auction
// backend, e.g.) can report that one of a project's products has a live
// dynamic offer/bid window, via /api/webhooks/product-offers. Kept
// deliberately generic (no biduniq-specific fields) — see that route for the
// per-project IntegrationCredential-based auth that gates it.

enum ProductOfferStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Product {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  externalId String
  name       String
  metadata   Json?

  offers ProductOffer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, externalId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
}

model ProductOffer {
  id        String @id @default(cuid())
  productId String

  externalRef String
  minPrice    Float?
  maxPrice    Float?
  status      ProductOfferStatus
  startsAt    DateTime?
  endsAt      DateTime?
  payload     Json?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, externalRef])
  @@index([productId])
}

model Opportunity {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  // Re-pointed from CompetitorInsight to the Agency OS Insight model.
  insightId String?

  title       String
  description String?
  status      OpportunityStatus @default(NEW)

  category SignalCategory?
  goalIds  String[]        @default([])

  valueScore       Float?
  urgencyScore     Float?
  confidenceScore  Float?
  riskScore        Float?
  evidenceStrength Float?
  nbaScore         Float?

  timeWindowStart DateTime?
  timeWindowEnd   DateTime?

  fingerprint   String?
  duplicateOfId String?
  cooldownUntil DateTime?
  isMock        Boolean   @default(false)

  insight Insight? @relation(fields: [insightId], references: [id], onDelete: SetNull)
  ideas   Idea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, fingerprint])
  @@index([projectId])
  @@index([brandId])
  @@index([status])
  @@index([projectId, status])
}

// =============================================================================
// BROWSER PROFILES / SOCIAL ACCOUNTS / SKILLS / CREDENTIALS
// =============================================================================

model BrowserProfile {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  name     String
  slug     String
  provider String                @default("openclaw")
  purpose  BrowserProfilePurpose

  status BrowserProfileStatus @default(READY)

  externalProfileId String?
  sessionReference  String?

  lastUsedAt        DateTime?
  lastHealthCheckAt DateTime?

  executionJobs      ExecutionJob[]
  humanInterventions HumanInterventionRequest[]
  socialAccounts     SocialAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, slug])
  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
  @@index([status])
}

model SocialAccount {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  platform SocialPlatform

  username    String
  displayName String?
  profileUrl  String?

  browserProfileId String?
  credentialId     String?

  status SocialAccountStatus @default(CONNECTING)

  lastVerifiedAt DateTime?

  browserProfile BrowserProfile?        @relation(fields: [browserProfileId], references: [id], onDelete: SetNull)
  credential     IntegrationCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, platform, username])
  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
}

// API-token-based integrations (as opposed to BrowserProfile's session/
// browser-automation model) — e.g. Telegram's Bot API. `encryptedSecret`
// is AES-256-GCM via src/server/security/crypto.ts (same cipher already
// used for TemporarySecret), never the plaintext token. `metadata` holds
// provider-specific config (Telegram: { chatId, chatTitle }).
model IntegrationCredential {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  provider     String
  accountLabel String?

  encryptedSecret String
  metadata        Json?

  status CredentialStatus @default(NOT_CONFIGURED)

  socialAccounts SocialAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // v1 scope: a single connection per project from this provider (for
  // Telegram, a single bot/single target chat) — unlike BrowserProfile,
  // multiple accounts are not supported here.
  @@unique([projectId, provider])
  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
}

// Google Analytics ambarı (docs/google-analytics-plan.md §4, GA-F2): proje ↔
// GA4 mülkü bağı; mülk metadata'sı, sağlık, kota ve senkron durumu. Satır,
// seçili mülkü olan ACTIVE `google_analytics` bağlantısından tembel oluşur
// (src/server/website-analytics/sync/links.ts); Disconnect bağı ve verisini
// siler. Mevcut modellere ilişki alanı yok: proje silme `projectId` kolonu
// olan her tabloyu kendiliğinden temizler (project-deletion.service.ts).
model GaPropertyLink {
  id           String  @id @default(cuid())
  workspaceId  String
  projectId    String
  credentialId String
  // GA4 mülk kimliği, "properties/" öneki olmadan.
  propertyId   String
  // Projenin şu an seçili mülkü. Seçim değişince eski bağ false olur, senkron
  // durur ve verisi ga-retention'da silinir.
  isPrimary    Boolean @default(true)
  isMock       Boolean @default(false)

  propertyName      String?
  accountId         String?
  accountName       String?
  timeZone          String?
  currencyCode      String?
  industryCategory  String?
  // GOOGLE_ANALYTICS_STANDARD | GOOGLE_ANALYTICS_360
  serviceLevel      String?
  propertyCreatedAt DateTime?
  streamId          String?
  measurementId     String?
  streamUri         String?
  // [{ eventName, countingMethod, createTime }]
  keyEvents         Json?
  // Olay verisi saklama süresi (TWO_MONTHS | FOURTEEN_MONTHS | ...).
  dataRetention     String?
  // { googleAds: <bağlantı sayısı> }
  linkedProducts    Json?
  // Katalogdan düşen raporlar: { [reportKey]: { reason, at } }
  catalog           Json?

  // OK | AUTH | NEEDS_PERMISSION | ACCESS_LOST | GONE | API_DISABLED |
  // DEGRADED | UNKNOWN
  health       String  @default("UNKNOWN")
  healthReason String?
  // GA-F3 ölçüm puanı (0-100).
  healthScore  Int?

  // Kota yöneticisi (src/lib/website-analytics/governor.ts): son
  // propertyQuota, blok süresi ve saatlik sunucu hatası sayacı.
  lastQuota        Json?
  rateLimitedUntil DateTime?
  serverErrorsHour Json?

  // Kilit ve "şu zamana kadar deneme" (geri çekilme, kota bloğu).
  syncLeaseUntil      DateTime?
  syncLeaseOwner      String?
  consecutiveFailures Int       @default(0)
  lastSyncError       String?
  lastMetadataAt      DateTime?
  // Son günlük çekim denemesi ve tamamlandığı mülk günü (YYYY-MM-DD).
  lastDailyAt         DateTime?
  lastDailyDate       String?
  // Geri doldurma durumu (src/lib/website-analytics/backfill.ts).
  backfill            Json?
  backfillDoneAt      DateTime?

  dailyTotals GaDailyTotal[]
  slices      GaReportSlice[]
  monthly     GaMonthlySummary[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, propertyId])
  @@index([propertyId])
  @@index([credentialId])
  @@index([isPrimary, syncLeaseUntil])
}

// Mülk-gün toplamı: KPI'ların tek kaynağı. `date` mülkün saat dilimindeki
// gündür. Para mikro birimdir (değer × 1.000.000, mülkün para birimi). Oturum
// süresi ortalama değil toplam olarak tutulur (dönem ortalaması kesin çıksın).
model GaDailyTotal {
  id                 String   @id @default(cuid())
  linkId             String
  projectId          String
  date               DateTime @db.Date
  activeUsers        Int      @default(0)
  newUsers           Int      @default(0)
  sessions           Int      @default(0)
  engagedSessions    Int      @default(0)
  engagementSec      Float    @default(0)
  sessionDurationSec Float    @default(0)
  screenPageViews    Int      @default(0)
  keyEvents          Float    @default(0)
  revenueMicros      BigInt   @default(0)
  transactions       Int      @default(0)
  quality            Json?
  // Revizyon penceresinden çıktı; bir daha çekilmez.
  isFinal            Boolean  @default(false)
  fetchedAt          DateTime

  link GaPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, date])
  @@index([projectId, date])
}

// Katalog raporunun bir dönemi (DAY: mülk günü; WEEK: ISO haftasının
// Pazartesisi). Satırlar kompakt: [boyutlar..., metrikler...].
model GaReportSlice {
  id               String   @id @default(cuid())
  linkId           String
  projectId        String
  reportKey        String
  // DAY | WEEK
  grain            String   @default("DAY")
  periodStart      DateTime @db.Date
  specVersion      Int
  dimensionHeaders String[]
  metricHeaders    String[]
  rows             Json
  rowCount         Int      @default(0)
  truncated        Boolean  @default(false)
  otherRow         Json?
  quality          Json?
  isFinal          Boolean  @default(false)
  fetchedAt        DateTime

  link GaPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, reportKey, grain, periodStart])
  @@index([projectId, reportKey, periodStart])
}

// Ay özeti: uzun dönem eğilimi ve geçen yılla karşılaştırma.
model GaMonthlySummary {
  id        String   @id @default(cuid())
  linkId    String
  projectId String
  // Ayın ilk günü.
  month     DateTime @db.Date
  totals    Json
  channels  Json
  topPages  Json
  isFinal   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  link GaPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, month])
  @@index([projectId, month])
}

