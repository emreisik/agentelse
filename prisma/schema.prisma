  diff    Json?

  competitor   Competitor          @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  fromSnapshot CompetitorSnapshot? @relation("ChangeFromSnapshot", fields: [fromSnapshotId], references: [id], onDelete: SetNull)
  toSnapshot   CompetitorSnapshot  @relation("ChangeToSnapshot", fields: [toSnapshotId], references: [id], onDelete: Cascade)
  insights     CompetitorInsight[]

  createdAt DateTime @default(now())

  @@index([competitorId])
}

model CompetitorInsight {
  id           String  @id @default(cuid())
  competitorId String
  changeId     String?

  insight    String
  confidence Float?

  competitor Competitor        @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  change     CompetitorChange? @relation(fields: [changeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([competitorId])
}

// =============================================================================
// PRODUCT / OFFER SIGNALS
// =============================================================================
// Generic inbound capability: an external system (an e-commerce/auction
// backend, e.g.) can report that one of a project's products has a live
// dynamic offer/bid window, via /api/webhooks/product-offers. Kept
// deliberately generic (no biduniq-specific fields) — see that route for the
// per-project IntegrationCredential-based auth that gates it.

enum ProductOfferStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Product {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  externalId String
  name       String
  metadata   Json?

  offers ProductOffer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, externalId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
}

model ProductOffer {
  id        String @id @default(cuid())
  productId String

  externalRef String
  minPrice    Float?
  maxPrice    Float?
  status      ProductOfferStatus
  startsAt    DateTime?
  endsAt      DateTime?
  payload     Json?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, externalRef])
  @@index([productId])
}

model Opportunity {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  // Re-pointed from CompetitorInsight to the Agency OS Insight model.
  insightId String?

  title       String
  description String?
  status      OpportunityStatus @default(NEW)

  category SignalCategory?
  goalIds  String[]        @default([])

  valueScore       Float?
  urgencyScore     Float?
  confidenceScore  Float?
  riskScore        Float?
  evidenceStrength Float?
  nbaScore         Float?

  timeWindowStart DateTime?
  timeWindowEnd   DateTime?

  fingerprint   String?
  duplicateOfId String?
  cooldownUntil DateTime?
  isMock        Boolean   @default(false)

  insight Insight? @relation(fields: [insightId], references: [id], onDelete: SetNull)
  ideas   Idea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, fingerprint])
  @@index([projectId])
  @@index([brandId])
  @@index([status])
  @@index([projectId, status])
}

// =============================================================================
// BROWSER PROFILES / SOCIAL ACCOUNTS / SKILLS / CREDENTIALS
// =============================================================================

model BrowserProfile {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  name     String
  slug     String
  provider String                @default("openclaw")
  purpose  BrowserProfilePurpose

  status BrowserProfileStatus @default(READY)

  externalProfileId String?
  sessionReference  String?

  lastUsedAt        DateTime?
  lastHealthCheckAt DateTime?

  executionJobs      ExecutionJob[]
  humanInterventions HumanInterventionRequest[]
  socialAccounts     SocialAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, slug])
  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
  @@index([status])
}

model SocialAccount {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  platform SocialPlatform

  username    String
  displayName String?
  profileUrl  String?

  browserProfileId String?
  credentialId     String?

  status SocialAccountStatus @default(CONNECTING)

  lastVerifiedAt DateTime?

  browserProfile BrowserProfile?        @relation(fields: [browserProfileId], references: [id], onDelete: SetNull)
  credential     IntegrationCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, platform, username])
  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
}

// API-token-based integrations (as opposed to BrowserProfile's session/
// browser-automation model) — e.g. Telegram's Bot API. `encryptedSecret`
// is AES-256-GCM via src/server/security/crypto.ts (same cipher already
// used for TemporarySecret), never the plaintext token. `metadata` holds
// provider-specific config (Telegram: { chatId, chatTitle }).
model IntegrationCredential {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  provider     String
  accountLabel String?

  encryptedSecret String
  metadata        Json?

  status CredentialStatus @default(NOT_CONFIGURED)

  socialAccounts SocialAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // v1 scope: a single connection per project from this provider (for
  // Telegram, a single bot/single target chat) — unlike BrowserProfile,
  // multiple accounts are not supported here.
  @@unique([projectId, provider])
  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
}

// Google Analytics ambarı (docs/google-analytics-plan.md §4, GA-F2): proje ↔
// GA4 mülkü bağı; mülk metadata'sı, sağlık, kota ve senkron durumu. Satır,
// seçili mülkü olan ACTIVE `google_analytics` bağlantısından tembel oluşur
// (src/server/website-analytics/sync/links.ts); Disconnect bağı ve verisini
// siler. Mevcut modellere ilişki alanı yok: proje silme `projectId` kolonu
// olan her tabloyu kendiliğinden temizler (project-deletion.service.ts).
model GaPropertyLink {
  id           String  @id @default(cuid())
  workspaceId  String
  projectId    String
  credentialId String
  // GA4 mülk kimliği, "properties/" öneki olmadan.
  propertyId   String
  // Projenin şu an seçili mülkü. Seçim değişince eski bağ false olur, senkron
  // durur ve verisi ga-retention'da silinir.
  isPrimary    Boolean @default(true)
  isSecondary  Boolean @default(false)
  isMock       Boolean @default(false)

  propertyName      String?
  accountId         String?
  accountName       String?
  timeZone          String?
  currencyCode      String?
  industryCategory  String?
  // GOOGLE_ANALYTICS_STANDARD | GOOGLE_ANALYTICS_360
  serviceLevel      String?
  propertyCreatedAt DateTime?
  streamId          String?
  measurementId     String?
  streamUri         String?
  // [{ eventName, countingMethod, createTime }]
  keyEvents         Json?
  // Olay verisi saklama süresi (TWO_MONTHS | FOURTEEN_MONTHS | ...).
  dataRetention     String?
  // { googleAds: <bağlantı sayısı> }
  linkedProducts    Json?
  // Katalogdan düşen raporlar: { [reportKey]: { reason, at } }
  catalog           Json?

  // OK | AUTH | NEEDS_PERMISSION | ACCESS_LOST | GONE | API_DISABLED |
  // DEGRADED | UNKNOWN
  health       String  @default("UNKNOWN")
  healthReason String?
  // GA-F3 ölçüm puanı (0-100).
  healthScore  Int?

  // Kota yöneticisi (src/lib/website-analytics/governor.ts): son
  // propertyQuota, blok süresi ve saatlik sunucu hatası sayacı.
  lastQuota        Json?
  rateLimitedUntil DateTime?
  serverErrorsHour Json?

  // Kilit ve "şu zamana kadar deneme" (geri çekilme, kota bloğu).
  syncLeaseUntil      DateTime?
  syncLeaseOwner      String?
  consecutiveFailures Int       @default(0)
  lastSyncError       String?
  lastMetadataAt      DateTime?
  // Son günlük çekim denemesi ve tamamlandığı mülk günü (YYYY-MM-DD).
  lastDailyAt         DateTime?
  lastDailyDate       String?
  // Geri doldurma durumu (src/lib/website-analytics/backfill.ts).
  backfill            Json?
  backfillDoneAt      DateTime?

  dailyTotals    GaDailyTotal[]
  slices         GaReportSlice[]
  monthly        GaMonthlySummary[]
  healthChecks   GaHealthCheck[]
  healthRun      GaHealthRun?
  configChanges  GaConfigChange[]
  bigQuerySource GaBigQuerySource?
  bigQueryDays   GaBigQueryDay[]
  funnels        GaFunnel[]
  changeWatch    GaChangeWatch?
  findings       GaFinding[]
  analysisRun    GaAnalysisRun?
  reportRun      GaReportRun?
  goalProgress   GaGoalProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, propertyId])
  @@index([propertyId])
  @@index([credentialId])
  @@index([isPrimary, syncLeaseUntil])
  @@index([isSecondary, syncLeaseUntil])
}

// Mülk-gün toplamı: KPI'ların tek kaynağı. `date` mülkün saat dilimindeki
// gündür. Para mikro birimdir (değer × 1.000.000, mülkün para birimi). Oturum
// süresi ortalama değil toplam olarak tutulur (dönem ortalaması kesin çıksın).
model GaDailyTotal {
  id                 String   @id @default(cuid())
  linkId             String
  projectId          String
  date               DateTime @db.Date
  activeUsers        Int      @default(0)
  newUsers           Int      @default(0)
  sessions           Int      @default(0)
  engagedSessions    Int      @default(0)
  engagementSec      Float    @default(0)
  sessionDurationSec Float    @default(0)
  screenPageViews    Int      @default(0)
  keyEvents          Float    @default(0)
  revenueMicros      BigInt   @default(0)
  transactions       Int      @default(0)
  quality            Json?
  // Revizyon penceresinden çıktı; bir daha çekilmez.
  isFinal            Boolean  @default(false)
  fetchedAt          DateTime

  link GaPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, date])
  @@index([projectId, date])
}

// Katalog raporunun bir dönemi (DAY: mülk günü; WEEK: ISO haftasının
// Pazartesisi). Satırlar kompakt: [boyutlar..., metrikler...].
model GaReportSlice {
  id               String   @id @default(cuid())
  linkId           String
  projectId        String
  reportKey        String
  // DAY | WEEK
  grain            String   @default("DAY")
  periodStart      DateTime @db.Date
  specVersion      Int
  dimensionHeaders String[]
  metricHeaders    String[]
  rows             Json
  rowCount         Int      @default(0)
  truncated        Boolean  @default(false)
  otherRow         Json?
  quality          Json?
  isFinal          Boolean  @default(false)
  fetchedAt        DateTime

  link GaPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, reportKey, grain, periodStart])
  @@index([projectId, reportKey, periodStart])
}

// Ay özeti: uzun dönem eğilimi ve geçen yılla karşılaştırma.
model GaMonthlySummary {
  id        String   @id @default(cuid())
  linkId    String
  projectId String
  // Ayın ilk günü.
  month     DateTime @db.Date
  totals    Json
  channels  Json
  topPages  Json
  isFinal   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  link GaPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, month])
  @@index([projectId, month])
}

// ---------------------------------------------------------------------------
// Search Console ambarı (docs/google-search-console-plan.md SC-F2,
// docs/search-analytics.md). Mevcut modellere ilişki yok: proje silme
// projectId kolonlu her tabloyu kendisi temizler; Gsc* tabloları kendi
// aralarında cascade'lidir. Disconnect bağı (credentialId) siler.
// ---------------------------------------------------------------------------

model GscSiteLink {
  id           String    @id @default(cuid())
  workspaceId  String
  projectId    String
  credentialId String
  // "sc-domain:example.com" ya da "https://www.example.com/"
  siteUrl      String
  // Projenin şu an seçili sitesi. Seçim değişince eski bağ false olur,
  // demotedAt yazılır, senkron durur ve 30 gün sonra seo-retention'da silinir.
  isPrimary    Boolean   @default(true)
  isSecondary  Boolean   @default(false)
  demotedAt    DateTime?
  isMock       Boolean   @default(false)

  // DOMAIN | URL_PREFIX
  propertyType        String?
  // siteOwner | siteFullUser | siteRestrictedUser
  permissionLevel     String?
  // Site projenin alan adını kapsıyor mu (null: projede alan adı yok).
  domainMatch         Boolean?
  // { empty: [searchType...], disabledSlices: [kind...], appearancePerDay, checkedAt }
  searchTypes         Json?
  // { v: 1, auto: [], user: [], removed: [], updatedAt } (src/lib/seo/brand-terms.ts)
  brandTerms          Json?
  // Günlük marka serisinin tamamlandığı terimlerin özeti ("none", "error" ya da
  // brandTermsHash); güncel terimlerin özetine eşitse ayrım hazırdır.
  brandSeriesHash     String?
  // GscQuery.isBrand'in en son tamamen hesaplandığı terimlerin özeti; null:
  // bir sonraki senkronda yeniden sınıflandır.
  brandClassifiedHash String?
  // SK3 (a): Google'ın 16 ayından eski veri saklanır; false: yalnız son 16 ay.
  archive             Boolean  @default(true)

  // OK | AUTH | NEEDS_PERMISSION | ACCESS_LOST | GONE | API_DISABLED |
  // DEGRADED | UNKNOWN
  health       String  @default("UNKNOWN")
  healthReason String?

  // Kota yöneticisi (src/lib/seo/governor.ts); aynı siteUrl'nin aynı kipteki
  // birincil bağlarına yazılır.
  rateLimitedUntil  DateTime?
  loadLimitedUntil  DateTime?
  heavyLimitedUntil DateTime?
  // { day: PT günü (YYYY-MM-DD), count }
  loadErrors        Json?

  // Kilit ve "şu zamana kadar deneme" (geri çekilme, kota bekletmesi).
  syncLeaseUntil      DateTime?
  syncLeaseOwner      String?
  consecutiveFailures Int       @default(0)
  lastSyncError       String?
  lastMetadataAt      DateTime?
  lastDailyAt         DateTime?
  // Son tamamlanan günlük pencere: "2026-10-06@18" (PT günü + saat)
  lastDailySlot       String?
  // Kesinleşen son PT günü (YYYY-MM-DD)
  lastFinalDate       String?
  lastFreshAt         DateTime?
  // Son çekilen haftanın Pazartesi'si ve ayın ilk günü (YYYY-MM-DD)
  lastWeeklyWeek      String?
  lastMonthlyMonth    String?
  // Geri doldurma durumu: ana geçmiş, boşluklar, ağır kuyruk, marka özeti
  // (src/lib/seo/backfill.ts)
  backfill            Json?
  backfillDoneAt      DateTime?

  dailyTotals        GscDailyTotal[]
  slices             GscDailySlice[]
  queries            GscQuery[]
  pages              GscPage[]
  weeklyQueries      GscWeeklyQuery[]
  weeklyPages        GscWeeklyPage[]
  weeklyPairs        GscWeeklyQueryPage[]
  monthlyQueries     GscMonthlyQuery[]
  monthlyPages       GscMonthlyPage[]
  periodFetches      GscPeriodFetch[]
  urlInspections     GscUrlInspection[]
  gscSitemaps        GscSitemap[]
  coverageWeeks      GscCoverageWeek[]
  seoFindings        SeoFinding[]
  seoClusters        SeoCluster[]
  seoQueryEmbeddings SeoQueryEmbedding[]
  seoEngineState     SeoEngineState?
  seoReports         SeoReport[]
  seoReportState     SeoReportState?
  seoGoalProgress    SeoGoalProgress[]
  contentPlans       SeoContentPlan[]
  splitTests         GscSplitTest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, siteUrl])
  @@index([siteUrl])
  @@index([credentialId])
  @@index([isPrimary, syncLeaseUntil])
  @@index([isSecondary, syncLeaseUntil])
}

// Arama türü başına günlük toplam (KPI'ların tek kaynağı). Gün PT'dir.
model GscDailyTotal {
  id                    String   @id @default(cuid())
  linkId                String
  projectId             String
  date                  DateTime @db.Date
  // web | image | video | news | discover | googleNews
  searchType            String
  clicks                Int      @default(0)
  impressions           Int      @default(0)
  // position × impressions
  positionWeighted      Float    @default(0)
  // Yalnız web: marka terimi içeren sorguların toplamı (null: henüz yok)
  brandClicks           Int?
  brandImpressions      Int?
  brandPositionWeighted Float?
  // dataState=all ile çekildi; kesinleşince üzerine yazılır
  fresh                 Boolean  @default(false)
  fetchedAt             DateTime

  link GscSiteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, date, searchType])
  @@index([projectId, date])
}

// Günlük kırılımlar (ülke ilk 50, cihaz, arama görünümü; yalnız kesin günler)
// ve 16 aydan eski aylar için aylık toplamları ("<kind>_month", date = ayın 1'i).
model GscDailySlice {
  id        String   @id @default(cuid())
  linkId    String
  projectId String
  // country | device | appearance | country_month | device_month | appearance_month
  kind      String
  date      DateTime @db.Date
  // [[key, clicks, impressions, positionWeighted], ...] tıklamaya göre
  rows      Json
  // [clicks, impressions, positionWeighted]: kırpılan satırların toplamı
  other     Json?
  rowCount  Int      @default(0)
  truncated Boolean  @default(false)
  fetchedAt DateTime

  link GscSiteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, kind, date])
  @@index([projectId, date])
}

// Sorgu sözlüğü (PII maskelenmiş metin).
model GscQuery {
  id            String   @id @default(cuid())
  linkId        String
  projectId     String
  text          String
  textHash      String
  isBrand       Boolean  @default(false)
  // SC-F4
  intent        String?
  language      String?
  clusterId     String?
  firstSeenWeek DateTime @db.Date
  lastSeenWeek  DateTime @db.Date

  link    GscSiteLink          @relation(fields: [linkId], references: [id], onDelete: Cascade)
  weekly  GscWeeklyQuery[]
  pairs   GscWeeklyQueryPage[]
  monthly GscMonthlyQuery[]

  @@unique([linkId, textHash])
  @@index([linkId, lastSeenWeek])
  @@index([linkId, clusterId])
  @@index([projectId])
}

// Sayfa sözlüğü (sorgu dizesi atılmış, yol maskelenmiş URL).
model GscPage {
  id            String   @id @default(cuid())
  linkId        String
  projectId     String
  url           String
  urlHash       String
  path          String
  pageGroup     String?
  firstSeenWeek DateTime @db.Date
  lastSeenWeek  DateTime @db.Date

  link    GscSiteLink          @relation(fields: [linkId], references: [id], onDelete: Cascade)
  weekly  GscWeeklyPage[]
  pairs   GscWeeklyQueryPage[]
  monthly GscMonthlyPage[]

  @@unique([linkId, urlHash])
  @@index([linkId, lastSeenWeek])
  @@index([projectId])
}

model GscWeeklyQuery {
  id               String   @id @default(cuid())
  linkId           String
  projectId        String
  // Pazartesi (PT haftası)
  weekStart        DateTime @db.Date
  queryId          String
  clicks           Int
  impressions      Int
  positionWeighted Float

  link  GscSiteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  query GscQuery    @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@unique([linkId, weekStart, queryId])
  @@index([projectId, weekStart])

  // FK cascade (GscQuery/GscPage silinirken) için: bu sütun hiçbir indexin başında değildi.
  @@index([queryId])
}

model GscWeeklyPage {
  id               String   @id @default(cuid())
  linkId           String
  projectId        String
  weekStart        DateTime @db.Date
  pageId           String
  clicks           Int
  impressions      Int
  positionWeighted Float

  link GscSiteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  page GscPage     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([linkId, weekStart, pageId])
  @@index([projectId, weekStart])

  // FK cascade (GscQuery/GscPage silinirken) için: bu sütun hiçbir indexin başında değildi.
  @@index([pageId])
}

model GscWeeklyQueryPage {
  id               String   @id @default(cuid())
  linkId           String
  projectId        String
  weekStart        DateTime @db.Date
  queryId          String
  pageId           String
  clicks           Int
  impressions      Int
  positionWeighted Float

  link  GscSiteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  query GscQuery    @relation(fields: [queryId], references: [id], onDelete: Cascade)
  page  GscPage     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([linkId, weekStart, queryId, pageId])
  @@index([projectId, weekStart])

  // FK cascade (GscQuery/GscPage silinirken) için: bu sütun hiçbir indexin başında değildi.
  @@index([queryId])
  @@index([pageId])
}

model GscMonthlyQuery {
  id               String   @id @default(cuid())
  linkId           String
  projectId        String
  // Ayın ilk günü (PT)
  month            DateTime @db.Date
  queryId          String
  clicks           Int
  impressions      Int
  positionWeighted Float

  link  GscSiteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  query GscQuery    @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@unique([linkId, month, queryId])
  @@index([projectId, month])

  // FK cascade (GscQuery/GscPage silinirken) için: bu sütun hiçbir indexin başında değildi.
  @@index([queryId])
}

model GscMonthlyPage {
  id               String   @id @default(cuid())
  linkId           String
  projectId        String
  month            DateTime @db.Date
  pageId           String
  clicks           Int
  impressions      Int
  positionWeighted Float

  link GscSiteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  page GscPage     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([linkId, month, pageId])
  @@index([projectId, month])

  // FK cascade (GscQuery/GscPage silinirken) için: bu sütun hiçbir indexin başında değildi.
  @@index([pageId])
}

// Hangi haftalık/aylık özetin çekildiği: idempotent senkron, kırpılma
// işareti ve anonim pay için satır toplamları.
model GscPeriodFetch {
  id             String   @id @default(cuid())
  linkId         String
  projectId      String
  // WEEK | MONTH
  grain          String
  periodStart    DateTime @db.Date
  // query | page | query_page
  key            String
  rowCount       Int      @default(0)
  truncated      Boolean  @default(false)
  rowClicks      Int      @default(0)
  rowImpressions Int      @default(0)
  pages          Int      @default(0)
  fetchedAt      DateTime
  // API | BQ: BQ ise dönem BigQuery dışa aktarımından yazıldı (SC-F9)
  source         String   @default("API")

  link GscSiteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, grain, periodStart, key])
  @@index([projectId, periodStart])
}

// GA-F3 ölçüm sağlığı (docs/measurement-health.md): bağ başına kontrolün güncel sonucu.
model GaHealthCheck {
  id            String    @id @default(cuid())
  linkId        String
  projectId     String
  // "MH1" … "MH24", "MH1_RT"
  checkKey      String
  // PASS | WARN | FAIL | UNKNOWN
  status        String
  // INFO | WARN | CRITICAL
  severity      String
  // Toplulaştırılmış kanıt (sayılar, neden kodu, izinli parametre adları);
  // ham URL ya da kişisel veri asla yok.
  evidence      Json?
  guideId       String
  firstFailedAt DateTime?
  lastCheckedAt DateTime
  lastChangedAt DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  link GaPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, checkKey])
  @@index([projectId, status])
}

// GA-F3: bağ başına denetim turu durumu (kilit, parmak izi, son site taraması,
// PII yoklaması, gün içi realtime ölçümleri, şüpheli günler).
model GaHealthRun {
  id                 String    @id @default(cuid())
  linkId             String    @unique
  workspaceId        String
  projectId          String
  fingerprint        String?
  evaluatedAt        DateTime?
  leaseUntil         DateTime?
  leaseOwner         String?
  recheckRequestedAt DateTime?
  siteCheckedAt      DateTime?
  // GaSiteTagResult (yalnız kimlikler, sayılar, boolean'lar)
  siteTag            Json?
  piiCheckedAt       DateTime?
  // GaPiiProbeResult (yalnız sayılar ve izinli parametre adları)
  piiProbe           Json?
  // GaRealtimeState
  realtime           Json?
  // { "YYYY-MM-DD": ["MH1", ...] }, 400 gün
  suspectDays        Json?
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  link GaPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([evaluatedAt])
}

// GA-F4 analiz motoru (docs/website-insights.md): bir kuralın bir dönem için
// ürettiği bulgu ve yaşam döngüsü. Parmak izi bağ + kural + konu özeti +
// dönemdir; aynı sorun her dönemde yeni bir satır olur (koşul kurallarında
// öncekini SUPERSEDED yapar). Kanıt yalnız toplulaştırılmış sayılar ve
// maskelenmiş yollar taşır. Her kapanış closedAt yazar; saklama closedAt'ten
// 730 gün sonra siler.
model GaFinding {
  id                String    @id @default(cuid())
  workspaceId       String
  projectId         String
  linkId            String
  // "AN1" … "AN12", "AN15" (src/lib/website-analytics/analysis/registry.ts)
  ruleKey           String
  ruleVersion       Int
  // ANOMALY | CHANGE | OPPORTUNITY | RISK | WIN
  kind              String
  // "site", "site:week", "page:/pricing", "channel:Organic Search:keyEventRate" … (maskelenmiş)
  subject           String
  // subject'in FNV-1a özeti (16 hex): parmak izi ve sinyal anahtarı yol taşımaz
  subjectKey        String
  // DAY | WEEK | MONTH | WINDOW28
  periodGrain       String
  // "2026-10-05" | "2026-W41" | "2026-09" | "2026-W41:28d" (+ ":wow" gibi ek)
  periodKey         String
  periodStart       DateTime  @db.Date
  periodEnd         DateTime  @db.Date
  // INFO | WARN | CRITICAL
  severity          String
  // SIGNIFICANT | DIRECTIONAL
  confidence        String
  // OPEN | ACCEPTED | DISMISSED | DONE | EVALUATED | EXPIRED | SUPERSEDED | RESOLVED
  status            String    @default("OPEN")
  // shadow | live: gölge modda üretilen bulgu kullanıcıya hiç gösterilmez
  mode              String
  isMock            Boolean   @default(false)
  priority          Float     @default(0)
  // GaFindingEvidence (v1)
  evidence          Json
  // GaImpact { metric, perWeek, low, high, directional }
  impact            Json?
  // LLM açıklaması (projenin içerik dili); number-check'ten geçmiş
  explanation       String?
  explainedAt       DateTime?
  // Haftalık LLM sıralaması (1 = en önemli)
  rank              Int?
  // Gölge satır canlıya devredilince `${fingerprint}#shadow:${id}` olur
  fingerprint       String    @unique
  previousId        String?
  occurrences       Int       @default(1)
  signalId          String?
  ideaIds           String[]  @default([])
  acceptedAt        DateTime?
  acceptedByUserId  String?
  dismissedAt       DateTime?
  dismissedByUserId String?
  doneAt            DateTime?
  // DONE'dan sonra en erken değerlendirme (doneAt + 36 gün)
  evaluateAfter     DateTime?
  evaluatedAt       DateTime?
  // WORKED | DIDNT | INCONCLUSIVE
  outcome           String?
  // GaOutcomeEvidence (v1)
  outcomeEvidence   Json?
  // ttl | newer | shadow | measurement | revised | recovered | dismissed | evaluated
  closedReason      String?
  // Her kapanışta yazılır (EXPIRED, SUPERSEDED, RESOLVED, DISMISSED, EVALUATED)
  closedAt          DateTime?
  // Gölge mod incelemesi (yalnız platform operatörü): USEFUL | NOT_USEFUL
  reviewVerdict     String?
  reviewedAt        DateTime?
  reviewedByUserId  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  link GaPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([linkId, ruleKey, subjectKey, periodStart])
  @@index([status, evaluateAfter])
  @@index([mode, createdAt])
  @@index([createdAt])
  @@index([closedAt])
}

// GA-F4: bağ başına analiz turu durumu (CAS kilidi, son günlük/haftalık/aylık
// dönem, son LLM açıklaması, son bakılma). stats yalnız kural sayaçlarıdır,
// Google verisi değildir.
model GaAnalysisRun {
  id                String    @id @default(cuid())
  linkId            String    @unique
  workspaceId       String
  projectId         String
  leaseUntil        DateTime?
  leaseOwner        String?
  // Aday seçimi adaleti: zamanı gelmese de her bakılışta yazılır
  lastCheckedAt     DateTime?
  // Değerlendirilen son mülk günü (AN1/AN15), YYYY-MM-DD
  lastDailyDay      String?
  lastDailyAt       DateTime?
  // Değerlendirilen son ISO hafta (Pazartesi), YYYY-MM-DD
  lastWeek          String?
  lastWeeklyAt      DateTime?
  // Değerlendirilen son takvim ayı (AN2 MoM, AN10), YYYY-MM
  lastMonth         String?
  // LLM açıklamasının yapıldığı son hafta (Pazartesi)
  lastExplainedWeek String?
  lastError         String?
  // Son turun kural başına aday/oluşan/atlanan sayıları
  stats             Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  link GaPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([lastDailyAt])
  @@index([lastCheckedAt])
}

// ---------------------------------------------------------------------------
// GA-F5 raporlama ve planlama (docs/website-reports.md). Mevcut modellere ilişki
// yok (GaPropertyLink'e geri ilişkiler hariç): proje silme projectId kolonlu her
// tabloyu kendisi temizler. GaReportRun ve GaGoalProgress bağla birlikte cascade
// ile gider (Disconnect "right away"). GaReportSettings Google verisi taşımaz.
// ---------------------------------------------------------------------------

// GA-F5 rapor ve uyarı tercihleri. Proje başına tek satır; satır yoksa
// varsayılanlar geçerlidir (src/lib/website-analytics/reports/settings.ts).
model GaReportSettings {
  id              String   @id @default(cuid())
  workspaceId     String
  projectId       String   @unique
  // Haftalık rapor; gün ISO hafta günü (1 = Pazartesi … 7 = Pazar), 08:00 proje saati
  weeklyEnabled   Boolean  @default(true)
  weeklyWeekday   Int      @default(1)
  // Aylık rapor + "Next month plan"; ayın günü (1-28), 08:00 proje saati
  monthlyEnabled  Boolean  @default(true)
  monthlyDay      Int      @default(2)
  // Günlük nabız: "notable" (yalnız not edilecek bir şey varsa) | "off"
  pulse           String   @default("notable")
  // Kritik ölçüm uyarısı: Website analytics sohbetine kart / projenin
  // Telegram'ına rakamsız mesaj (SiteAlerts)
  alertChat       Boolean  @default(true)
  alertTelegram   Boolean  @default(true)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// GA-F5: bağ başına rapor turu durumu (CAS kilidi, dönem başına "yapıldı"
// işaretleri, nabız beklemesi, deneme sayaçları, adil aday sırası). stats ve
// attempts yalnız sayaçtır; lastError yalnız hata adı/kodudur (Google verisi yok).
model GaReportRun {
  id                String    @id @default(cuid())
  linkId            String    @unique
  workspaceId       String
  projectId         String
  leaseUntil        DateTime?
  leaseOwner        String?
  // Aday seçimi adaleti: zamanı gelmese de her bakılışta yazılır
  lastCheckedAt     DateTime?
  // Değerlendirilen son nabız günü (mülk günü, YYYY-MM-DD); sessiz geçse de yazılır
  lastPulseDay      String?
  // Son nabız değerlendirmesinin zamanı ("yeni uyarı" sınırı)
  lastPulseAt       DateTime?
  // GA-F4 günlük analizini bekleyen nabız günü ve beklemenin başladığı an (en çok 3 saat)
  pulsePendingDay   String?
  pulsePendingSince DateTime?
  // Son haftalık raporun Pazartesi'si (mülk günü); atlanan hafta da yazılır
  lastWeek          String?
  // Son aylık rapor ayı (YYYY-MM)
  lastMonth         String?
  // Son "Next month plan" hedef ayı (YYYY-MM)
  lastPlanMonth     String?
  // Hedeflerin güncellendiği son tam mülk günü (completeThrough)
  lastGoalsDay      String?
  // Kritik uyarı kartları için son tarama
  lastAlertScanAt   DateTime?
  // { "<variant>:<periodKey>": hata sayısı } (en çok 12 anahtar)
  attempts          Json?
  // Yalnız hata adı / Prisma kodu (ör. "P2028"), mesaj değil
  lastError         String?
  // { posted: {...}, skipped: {...}, narrative: {...} } sayaçları
  stats             Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  link GaPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([lastCheckedAt])
}

// GA-F5: web.* hedefinin bu ayki ilerlemesi (Brand Brain → Goals'taki tempo ve
// tahmin). Ay ve günler mülk saatindedir. Tempo saklanmaz: okurken hedefin
// güncel targetValue'su ile hesaplanır (expectedShare × hedef). Hedef silinince
// ya da anahtarı değişince günlük işte silinir.
model GaGoalProgress {
  id            String   @id @default(cuid())
  goalId        String   @unique
  linkId        String
  workspaceId   String
  projectId     String
  // web.sessions | web.key_events | web.revenue
  metricKey     String
  // "2026-10"
  month         String
  // Hesabın dayandığı son tam mülk günü (YYYY-MM-DD)
  through       String
  dayOfMonth    Int
  daysInMonth   Int
  monthToDate   Float
  // Haftanın günü ağırlıklı: ayın bu güne kadar beklenen payı (0-1)
  expectedShare Float?
  forecast      Float?
  forecastLow   Float?
  forecastHigh  Float?
  // ok | short_history | no_baseline | complete
  forecastBasis String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  link GaPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([linkId])
}

// ---- GA-F6 (GA_UTM): etiketli dış linkler ve link izleme ayarı ----
// GA-F6 (GA_UTM): Agentelse'in etiketlediği dış link (docs/google-analytics-plan.md §3.8, §4).
// utm_content=agx_<code> GA4'te sessionManualAdContent olarak görünür; campaign
// dilimleri bu kodla Agentelse varlığına bağlanır. Google verisi taşımaz:
// GA Disconnect'te kalır, proje silinince (projectId tablosu) gider.
model TrackedLink {
  id                 String   @id @default(cuid())
  // 6 karakter [a-z0-9]; bütün projelerde benzersiz (aynı GA mülkü iki projeye bağlı olabilir)
  code               String   @unique
  workspaceId        String
  projectId          String
  // "meta_ad" | "instagram_bio" | "facebook_post" | "social_post"
  entityType         String
  // meta_ad: "<commandId>:<adIndex>"; instagram_bio: "bio"; post: Creative/Post id
  entityId           String
  // UtmChannel: "meta_ads" | "facebook" | "instagram" | "linkedin" | "x" | "tiktok"
  channel            String
  destinationUrl     String
  // Hedef adres + eklenen UTM'ler (Meta makroları ham); carriesCode buradan türetilir
  taggedUrl          String
  utmSource          String
  utmMedium          String
  utmCampaign        String
  utmContent         String
  // İnsan okunur kısa ad (kampanya / plan adı), en çok 120 karakter
  label              String?
  // meta_ad için tembel çözülür (AdsLaunch.campaignExternalId, progress.ads[i])
  campaignExternalId String?
  adExternalId       String?
  createdByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([projectId, entityType, entityId])
  @@index([projectId, utmCampaign])
  @@index([projectId, campaignExternalId])
  @@index([projectId, adExternalId])
  @@index([entityType, entityId])
}

// GA-F6 (GA_UTM): Settings → Publishing → "Add tracking (UTM) to links" (GK10).
// Satır yoksa açık sayılır. Google verisi taşımaz.
model LinkTrackingSetting {
  id              String   @id @default(cuid())
  workspaceId     String
  projectId       String   @unique
  utmEnabled      Boolean  @default(true)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================================
// GA-F7 (migration 20261006219000_add_ga_config_change)
// ============================================================================
// COMPANION MIGRATION (own folder, sorts before the main one, not referenced by the SQL of the main one):
//   20261006218900_add_analytics_edit_capability/migration.sql
//   ALTER TYPE "CapabilityKey" ADD VALUE IF NOT EXISTS 'ANALYTICS_EDIT';
// and in schema.prisma, enum CapabilityKey: add the line  ANALYTICS_EDIT  (next to ANALYTICS_ANALYSIS).
//

// GA-F7: GA yapilandirma yazmasinin kaydi (docs/website-fixes.md). Onay, uygulama,
// geri okuma ve geri alma bu satirda izlenir. before/after/params Google'dan okunan
// yapilandirma icerir (olay adi, saklama suresi, ayar bayraklari); sayi ya da kisisel
// veri yok. Disconnect bagi siler, satirlar cascade ile hemen gider.
model GaConfigChange {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  linkId      String

  // KEY_EVENT_CREATE | RETENTION_14M | ENHANCED_MEASUREMENT | CHANNEL_GROUP_AI | ANNOTATION_CREATE
  kind         String
  // PROPOSED | APPROVED | APPLYING | APPLIED | VERIFIED | FAILED | UNDOING | UNDONE | REJECTED | EXPIRED
  status       String  @default("PROPOSED")
  // GUIDE | PANEL | AUTO | API
  source       String
  // Kullaniciya gosterilen sabit Ingilizce baslik (en cok 80 karakter).
  title        String
  // Dogrulanmis eylem girdisi: GaFixParams (kind dahil).
  params       Json
  // Uygulamadan hemen once canli okunan durum ve geri okunan sonraki durum: GaFixSnapshot.
  before       Json?
  after        Json?
  // Google kaynak adi (properties/1/keyEvents/2); geri alma ve degisim gecmisi eslemesi icin.
  resourceName String?
  // Ayni (bag, tur, konu) icin tek acik degisiklik: dedupeKey, acik durumlarda openKey'e de yazilir.
  dedupeKey    String
  openKey      String?
  // Zaten saglanmisti: yazma yapilmadi, geri alinamaz.
  noop         Boolean @default(false)

  taskId           String?
  approvalId       String?
  // USER | SYSTEM
  proposedByType   String
  proposedByUserId String?
  approvedByUserId String?
  undoneByUserId   String?

  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  leaseUntil    DateTime?
  leaseOwner    String?
  expiresAt     DateTime

  approvedAt   DateTime?
  appliedAt    DateTime?
  verifiedAt   DateTime?
  rolledBackAt DateTime?
  failedAt     DateTime?
  // { code, message, retryable?, undo? }: sabit metin, Google ham hatasi yok.
  error        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  link GaPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, openKey])
  @@index([projectId, createdAt])
  @@index([linkId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([taskId])
  @@index([approvalId])
}

// GA-F7: degisim gecmisi taramasinin bag basina durumu (imlec, kilit, son hata kodu).
model GaChangeWatch {
  id          String @id @default(cuid())
  linkId      String @unique
  workspaceId String
  projectId   String

  // Son basarili turda gorulen en ileri zaman; sonraki tur 1 saat ortusmeyle buradan baslar.
  // Izin yeniden verilince (markGaEditGranted) null'a cekilir: aradaki bosluk icin uyari uretilmez.
  cursorAt       DateTime?
  lastRunAt      DateTime?
  lastEventCount Int       @default(0)
  lastAlertCount Int       @default(0)
  leaseUntil     DateTime?
  leaseOwner     String?
  // Yalniz hata kodu: permission | scope_missing | reconnect | rate_limited | google_unavailable | truncated | unknown
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  link GaPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([lastRunAt])
}

// ===========================================================================
// GA-F8 ajans ve ileri ölçek (migration 20261006222000_add_ga_agency)
// ===========================================================================
// Beyaz etiket marka ve paylaşım bağlantısı tabloları (ReportBranding, ReportShare) SC-F9'undur
// (migration 20261006223000_add_gsc_agency); GA-F8 yalnız onları kullanır, burada TANIMLANMAZ.
// Başka mevcut modele dokunulmaz. IntegrationCredential'a keyId kolonu EKLENMEZ: anahtar sürümü şifreli metnin önekindedir (gk1:<keyId>:...).

// Google RISC (Cross-Account Protection) olayları. Açıkça globaldir (proje yok).
// Yalnız tekrar koruması ve sayaç: Google hesap kimliği (sub) ASLA saklanmaz.
model GoogleRiscEvent {
  id         String   @id @default(cuid())
  // Güvenlik olayı jetonunun jti'si: tekrar koruması
  jti        String   @unique
  // tokens-revoked | token-revoked | account-disabled | account-enabled | account-purged | sessions-revoked | credential-change-required | verification
  eventKeys  String[]
  // PENDING (uygulanmadan önce eklenir; takılı kalırsa Google'ın yeniden denemesi tekrar işler) | APPLIED | RECHECK | NO_MATCH | IGNORED
  outcome    String   @default("PENDING")
  // Etkilenen bağlantı sayısı
  matched    Int      @default(0)
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

// GA4 BigQuery dışa aktarımı kaynağı (GA_BIGQUERY). Bağ başına en çok bir satır. Müşteri kendi
// projesindeki veri kümesine Agentelse'in servis hesabına (SC-F9 paylaşımlı istemcisi) okuma yetkisi verir.
// TEK PROJE KURALI: veri kümesinin projesi ile sorgu işinin (faturalanan) projesi aynıdır (gcpProjectId);
// ayrı faturalama projesi alanı YOKTUR (başka müşterinin projesine fatura kesme açığı). Veri kümesi adı
// analytics_<mülk kimliği> olmak ZORUNDADIR (bağlama kuralı). Yeni OAuth izni yok. Bağ silinince cascade ile gider.
model GaBigQuerySource {
  id              String    @id @default(cuid())
  workspaceId     String
  projectId       String
  linkId          String    @unique
  // Veri kümesinin ve sorgu işlerinin (faturalama) tek Google Cloud projesi
  gcpProjectId    String
  // Daima analytics_<GA4 mülk kimliği>
  datasetId       String
  location        String?
  // PENDING | OK | ERROR
  status          String    @default("PENDING")
  // Yalnız hata kodu: not_configured | not_shared | dataset_not_found | no_export_tables | bytes_limit | budget | billing | auth | quota | invalid_query | unavailable
  lastError       String?
  verifiedAt      DateTime?
  // Okunan en son dışa aktarım günü (YYYY-MM-DD)
  lastDay         String?
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  leaseUntil      DateTime?
  leaseOwner      String?
  // Aylık bayt bütçesi sayacı: ay (YYYY-MM) ve o ayki faturalanan bayt (üç sorgunun toplamı)
  usageMonth      String?
  usageBytes      BigInt    @default(0)
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  link GaPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
  @@index([projectId])
}

// Dışa aktarımdan türeyen günlük toplamlar (ham satır yok). Para mikro birimdir (olay para birimi, yalnız bilgi).
// topEvents: [[eventName, count]] ilk 20; topPages: [[maskeliYol, views, users]] ilk 50 (sorgu dizesi atılmış, PII maskeli).
model GaBigQueryDay {
  id            String   @id @default(cuid())
  workspaceId   String
  projectId     String
  linkId        String
  date          DateTime @db.Date
  events        Int
  users         Int
  sessions      Int
  keyEvents     Int
  revenueMicros BigInt   @default(0)
  topEvents     Json?
  topPages      Json?
  computedAt    DateTime @default(now())

  link GaPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, date])
  @@index([projectId])
}

// Huni raporu tanımı ve son sonucu (GA_FUNNEL, v1alpha runFunnelReport). Mülk başına en çok 5.
// lastResult yalnız toplulaştırılmış sayılardır. Bağ silinince cascade ile gider.
model GaFunnel {
  id              String    @id @default(cuid())
  workspaceId     String
  projectId       String
  linkId          String
  name            String
  isOpen          Boolean   @default(false)
  // [{ name, kind: "event" | "page", value }] 2..6 adım
  steps           Json
  periodDays      Int       @default(28)
  // { through, steps: [{ name, users, completionRate, abandonments, abandonmentRate }] }
  lastResult      Json?
  lastRunAt       DateTime?
  // Gerçek çalıştırma sayacı (günlük 20 sınırı mülk başına bu sayaçların toplamıdır; önce artır, sonra denetle)
  // UTC gün anahtarı (YYYY-MM-DD); bugünden farklıysa runsToday sıfır sayılır
  runDay          String?
  runsToday       Int       @default(0)
  // Yalnız hata kodu
  lastError       String?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  link GaPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Ajans ve büyük site (docs/google-search-console-plan.md SC-F9,
// docs/search-agency.md). Google'dan türeyen veri (bölünmüş test sonuçları,
// BigQuery ile yazılan dönem özetleri) GscSiteLink'e cascade'lidir; müşterinin
// kendi ayarları (sayfa grubu kuralları, ek site listesi, BigQuery proje/veri
// kümesi, marka/paylaşım) bağdan bağımsızdır ve Disconnect'te silinir.
// ---------------------------------------------------------------------------

// Not: Bu tabloların hiçbiri GscSiteLink/Project'e FK'lı değildir (GscSplitTest hariç); temizlik forget.ts, yetim süpürmesi ve Disconnect ile yapılır.

// Site başına müşteri ayarı: ek site üyeliği ve sayfa grubu kuralları. Bağ
// silinse de ("Delete stored data") kalır; Disconnect siler. Mod (mock/canlı)
// isMock ile ayrılır; yanlış moddaki satırlar yok sayılır ve ASLA çevrilmez.
model GscSiteSetting {
  id          String  @id @default(cuid())
  workspaceId String
  projectId   String
  siteUrl     String
  isMock      Boolean @default(false)

  // true: bu site projenin ek sitesi (birincil değil)
  isExtra Boolean @default(false)

  // { v: 1, rules: [{ id, group, match: "PREFIX" | "GLOB" | "EXACT", pattern }] } (src/lib/seo/agency/page-groups.ts)
  pageGroupRules       Json?
  // Her kayıtta +1
  rulesVersion         Int       @default(0)
  // GscPage.pageGroup'a en son tamamen uygulanan kural sürümü ve o andaki GscSiteLink.lastWeeklyWeek
  groupsAppliedVersion Int       @default(0)
  groupsAppliedWeek    String?
  // Yarım kalan uygulamanın son GscPage kimliği (anahtarlı sayfalama)
  groupsCursor         String?
  groupsLeaseUntil     DateTime?
  groupsLeaseOwner     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, siteUrl])
  @@index([workspaceId])
  @@index([isExtra, projectId])
}

// Site başına BigQuery dışa aktarım kaynağı (yapılandırma + maliyet sayaçları).
// Müşteri kendi veri kümesinde Agentelse'in servis hesabına okuma yetkisi verir;
// sorgular müşterinin Cloud projesinde çalışır ve onun faturasına yazılır.
// Etkinleştirme yalnız GscSiteLink.permissionLevel = siteOwner ise mümkündür.
model GscBqSource {
  id          String  @id @default(cuid())
  workspaceId String
  projectId   String
  siteUrl     String
  isMock      Boolean @default(false)

  // DRAFT | VERIFIED | ACTIVE | PAUSED | ERROR | BUDGET
  status            String    @default("DRAFT")
  // Müşterinin Cloud proje kimliği ve Search Console dışa aktarım veri kümesi (varsayılan "searchconsole")
  bqProjectId       String
  dataset           String
  // Veri kümesinin konumu (doğrulamada okunur)
  location          String?
  // Dışa aktarım tablolarındaki site_url değeri (doğrulamada eşleşen; yalnız bu mülk okunur)
  bqSiteUrl         String?
  // Dışa aktarımın ilk ve son tam gün anahtarı (PT, YYYY-MM-DD)
  exportStart       String?
  exportedThrough   String?
  coverageCheckedAt DateTime?
  // true: pencere içindeki kırpılmamış API dönemleri de BigQuery ile değişir
  importAll         Boolean   @default(false)

  // Maliyet kalkanı (bayt): sorgu başına üst sınır ve aylık bütçe
  maxBytesPerQuery   BigInt  @default(10737418240)
  monthlyBudgetBytes BigInt  @default(322122547200)
  // "YYYY-MM"; ay dönünce sayaçlar sıfırlanır
  usageMonth         String?
  bytesBilledMonth   BigInt  @default(0)
  queriesMonth       Int     @default(0)

  lastVerifiedAt      DateTime?
  lastSyncAt          DateTime?
  // Sabit hata kodu (NOT_OWNER, NO_ACCESS, NOT_FOUND, BILLING_DISABLED, SITE_MISMATCH, NO_EXPORT_DATA, COST_CAP ...); ham Google hatası saklanmaz
  lastError           String?
  consecutiveFailures Int       @default(0)
  nextRunAt           DateTime?
  leaseUntil          DateTime?
  leaseOwner          String?
  // { checkedAt, days, clicksDiffPct, impressionsDiffPct } (BigQuery ile API'nin son günleri); Google türevidir, "Delete stored data" siler
  reconcile           Json?
  createdByUserId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, siteUrl])
  @@index([status, nextRunAt])
  @@index([workspaceId])
}

// Bölünmüş SEO testi (plan 6.4): her sayfa grubunun kendi içinde rastgele
// ikiye ayrılması, değişiklik yalnız test yarısına uygulanır, fark-içinde-fark
// ve plasebo (A/A) denetimiyle ölçülür.
model GscSplitTest {
  id          String  @id @default(cuid())
  workspaceId String
  projectId   String
  linkId      String
  isMock      Boolean @default(false)

  // Kullanıcının verdiği ad (en çok 80 karakter)
  name        String
  // TITLE_META | SCHEMA | INTERNAL_LINKS_BLOCK | CONTENT_BLOCK | TEMPLATE_CHANGE | OTHER
  changeKind  String
  // Kullanıcının kendi metni (en çok 300 karakter; Google verisi değil)
  description String?
  // DRAFT | APPLIED | EVALUATING | WORKED | DIDNT | INCONCLUSIVE | CANCELLED | EXPIRED
  status      String  @default("DRAFT")

  // { v: 1, pageGroups: string[], capped: boolean, preWeeks: string[] }
  population   Json
  // Atama tohumu (= test kimliği); aynı tohum aynı ayrımı verir
  seed         String
  testPages    Int    @default(0)
  controlPages Int    @default(0)
  // { testClicks, controlClicks, ratio, recommended: boolean, perGroup: [{ group, test, control }] } (atama anındaki 8 haftalık tıklama)
  balance      Json
  // { titlePattern, metaPattern, schemaType, note } (kullanıcının kendi içeriği)
  change       Json?

  // MANUAL | CMS
  appliedVia      String?
  appliedAt       DateTime?
  appliedByUserId String?
  // { v: 1, items: [{ pageId, changeId | null, skipped | null }] } (SC-F8 SeoChange kimlikleri, düz kimlik)
  cmsChanges      Json?
  // Örnek sayfaların uygulama öncesi hâli (tarayıcıdan, sitenin kendi verisi; yalnız birincil bağ ve kapsam içi adresler): { v: 1, test: [...], control: [...] }
  baseline        Json?
  // { v: 1, attempts, lastCheckedAt, checks: [{ key, label, ok, observed }], method, reason }
  verification    Json?
  verifyAttempts  Int       @default(0)
  askedAt         DateTime?

  // Ölçüm çıpası ve penceresi (SC-F6 measuringFields)
  measureFrom   DateTime?
  windowDays    Int       @default(28)
  evaluateAfter DateTime?
  nextCheckAt   DateTime?
  // SplitEvaluation (src/lib/seo/agency/split/types.ts)
  evaluation    Json?
  // WORKED | DIDNT | INCONCLUSIVE
  outcome       String?
  // SIGNIFICANT | DIRECTIONAL
  confidence    String?
  evaluatedAt   DateTime?

  leaseUntil      DateTime?
  leaseOwner      String?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  link  GscSiteLink        @relation(fields: [linkId], references: [id], onDelete: Cascade)
  pages GscSplitTestPage[]

  @@index([linkId, status])
  @@index([projectId, isMock, status])
  @@index([status, nextCheckAt])
}

// Testin sayfa ataması (GscPage kimliği düz kimliktir: sayfa budanırsa satır
// yetim kalır, değerlendirme eksik sayfayı atlar).
model GscSplitTestPage {
  id        String @id @default(cuid())
  testId    String
  linkId    String
  pageId    String
  // Sayfanın grubu atama anında (denge raporu için)
  pageGroup String @default("")
  // TEST | CONTROL
  arm       String

  test GscSplitTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, pageId])
  @@index([linkId, pageId])
  @@index([testId, arm])
}

// Beyaz etiket: workspace başına ajans markası (rapor başlığı, vurgu rengi, alt not).
// Bilinçli istisna: projectId yok, tablo workspace kapsamlıdır (marka projeler arası ortaktır).
model ReportBranding {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  // En çok 60 karakter; boşsa Workspace.name kullanılır
  displayName     String
  // slate | blue | green | violet | orange | rose
  accent          String   @default("slate")
  // En çok 160 karakter
  footer          String?
  // Asset.id (type LOGO, aynı workspace, png/jpeg/webp); düz kimlik
  logoAssetId     String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Süreli, iptal edilebilir salt-okunur rapor bağlantısı. Genel (GA-F8 de
// kullanır): reportId düz kimliktir; görüntülemede raporun hâlâ var olduğu
// denetlenir, Disconnect/silme bağlantıları hemen siler.
model ReportShare {
  id              String    @id @default(cuid())
  workspaceId     String
  projectId       String
  // SEARCH | WEBSITE
  kind            String
  // SeoReport.id (SEARCH) ya da GA rapor kimliği (WEBSITE)
  reportId        String
  // Gizli parçanın sha256 özeti (hex); gizli parça saklanmaz
  tokenHash       String    @unique
  // { displayName, accent, footer, logoAssetId } oluşturma anındaki marka
  branding        Json
  expiresAt       DateTime
  revokedAt       DateTime?
  createdByUserId String
  viewCount       Int       @default(0)
  lastViewedAt    DateTime?
  createdAt       DateTime  @default(now())

  @@index([projectId, kind, reportId])
  @@index([expiresAt])
  @@index([workspaceId, revokedAt])
}

// Migration SQL notları (orkestratör): ALTER TABLE "GaPropertyLink" ADD COLUMN "isSecondary" BOOLEAN NOT NULL DEFAULT false;
// CREATE INDEX "GaPropertyLink_isSecondary_syncLeaseUntil_idx"; 4 CREATE TABLE (GoogleRiscEvent, GaBigQuerySource, GaBigQueryDay, GaFunnel);
// GaBigQuerySource / GaBigQueryDay / GaFunnel için FOREIGN KEY ("linkId") REFERENCES "GaPropertyLink"("id") ON DELETE CASCADE ON UPDATE CASCADE;
// UNIQUE: GoogleRiscEvent.jti, GaBigQuerySource.linkId, GaBigQueryDay(linkId,date). GoogleRiscEvent.outcome DEFAULT 'PENDING'; GaFunnel.runsToday DEFAULT 0.
// Yalnız ekleme; mevcut migration klasörlerine dokunulmaz. AgencyBranding ve GaReportShare YOKTUR (SC-F9'un ReportBranding / ReportShare tabloları kullanılır).
// Klasör sırası: bugünkü son klasör 20261006218000; W5-W7 migration'ları 222000'den ÖNCE olmalı, SC-F9'un 223000'ı SONRA gelmeli.

// Migration SQL notes for the orchestrator (main migration): CREATE TABLE "GaConfigChange" / "GaChangeWatch" with the columns above,
// UNIQUE INDEX "GaConfigChange_linkId_openKey_key" ("linkId","openKey"), UNIQUE INDEX on "GaChangeWatch"."linkId",
// the listed indexes, and FOREIGN KEY ("linkId") REFERENCES "GaPropertyLink"("id") ON DELETE CASCADE ON UPDATE CASCADE for both tables.
// NAMING: the Prisma TYPE is GaChangeWatch; the exported server const is GaChangeWatcher, so both can be imported in one file.

// ---------------------------------------------------------------------------
// Arama sağlığı ve teknik denetim (docs/google-search-console-plan.md SC-F3,
// docs/search-health.md). Gsc* tabloları Search Console bağına (GscSiteLink)
// cascade'lidir: Disconnect ve "Delete stored data" onları da hemen siler.
// Seo* tabloları sitenin kendisinden (kendi tarayıcımız, CrUX) gelir, projeye
// (SeoSite) bağlıdır ve GSC'siz projede de (doğrulanmış alan adıyla) çalışır.
// SearchUpdate globaldir (Google güncellemeleri takvimi).
// ---------------------------------------------------------------------------

// Proje başına arama sağlığı durumu (kip başına bir satır). Zaman alanlarında
// null = "boşta" (koşucu adayı değil); ensureForProject / ayar / doğrulama
// yeniden kurar.
model SeoSite {
  id          String  @id @default(cuid())
  workspaceId String
  projectId   String
  isMock      Boolean @default(false)

  // Tarama kapsamı (src/lib/seo/crawl-url.ts CrawlScope) ve özeti; scopeKey
  // değişince ya da null olunca sayfalar, taramalar, linkler ve CWV silinir.
  scope    Json?
  scopeKey String?
  // "https://www.example.com": ana sayfanın son adresinin kökü
  origin   String?

  // Agentelse alan adı doğrulaması (GSC'siz projeler); "Delete audit data"
  // bunları korur.
  verifyToken     String?
  verifiedDomain  String?
  // META | DNS | MOCK
  verifyMethod    String?
  verifiedAt      DateTime?
  verifyCheckedAt DateTime?
  verifyFailures  Int       @default(0)

  // { v: 1, crawlEnabled: boolean, pageLimit: 100 | 250 | 500 }
  settings Json?

  // robots.txt (kendi okumamız; herkese açık dosya, ≤ 512 KB)
  robotsStatus         Int?
  // OK | MISSING | SERVER_ERROR | UNREACHABLE
  robotsVerdict        String?
  robotsHash           String?
  robotsBody           String?
  robotsPrevBody       String?
  robotsFetchedAt      DateTime?
  robotsChangedAt      DateTime?
  // Yalnız yeniden deneme de başarısız olunca artar (art arda)
  robotsFailures       Int       @default(0)
  // Hata sonrası geri çekilme (30 dk'dan 6 saate katlanır)
  robotsRetryAt        DateTime?
  // http://<host>/ https'e yönleniyor mu (SH16)
  httpRedirectsToHttps Boolean?
  httpCheckedAt        DateTime?

  // Kendi sitemap okumamızın özeti: [{ url, source, status, kind, urlCount,
  // inScope, errors[], fetchedAt }]
  sitemaps          Json?
  sitemapsCheckedAt DateTime?
  // İlk eksiksiz sitemap geçişi (taban çizgisi); öncesindeki URL'ler "yeni" sayılmaz
  sitemapBaselineAt DateTime?
  // GSC sitemaps.list son okunuşu (GscSitemap tablosu) ve sıradaki deneme
  gscSitemapsAt     DateTime?
  gscSitemapsNextAt DateTime?

  // Tarayıcı kilidi ve zamanlaması
  crawlLeaseUntil  DateTime?
  crawlLeaseOwner  String?
  crawlNextAt      DateTime?
  crawlPausedUntil DateTime?
  crawlThrottles   Int       @default(0)
  crawlBlocked     Boolean   @default(false)
  fullCrawlDueAt   DateTime?
  lastFullCrawlAt  DateTime?
  regressionDueAt  DateTime?
  lastRegressionAt DateTime?
  lastCrawlError   String?

  // URL Inspection bütçesi (PT günü) ve kuyruğu
  inspectDay         String?
  inspectCount       Int       @default(0)
  inspectBudget      Int       @default(200)
  inspectNextAt      DateTime?
  inspectLastRunAt   DateTime?
  inspectPausedUntil DateTime?
  // [{ url, urlHash, requestedAt, by: "user" | "watchdog" }] en çok 20 (P1);
  // yalnız src/server/seo/site/inspect-queue.ts'in atomik SQL'i yazar
  inspectQueue       Json?

  cwvCheckedAt DateTime?

  // Search health puanı (src/lib/seo/health/score.ts)
  healthScore      Int?
  healthParts      Json?
  healthComputedAt DateTime?
  healthDueAt      DateTime?

  pages  SeoPage[]
  crawls SeoCrawl[]
  links  SeoLink[]
  cwv    SeoCwv[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, isMock])
  @@index([isMock, crawlNextAt])
  @@index([isMock, inspectNextAt])
  @@index([isMock, gscSitemapsNextAt])
  @@index([isMock, healthDueAt])
}

// Bir tarama koşusu: haftalık tam tarama ya da 6 saatlik gerileme bekçisi.
model SeoCrawl {
  id           String    @id @default(cuid())
  siteId       String
  workspaceId  String
  projectId    String
  // FULL | REGRESSION
  kind         String
  // RUNNING | DONE | PARTIAL | BLOCKED | FAILED
  status       String
  startedAt    DateTime
  finishedAt   DateTime?
  pagesFetched Int       @default(0)
  notModified  Int       @default(0)
  errors       Int       @default(0)
  budget       Int
  robotsHash   String?
  // Bekleyen kuyruk { v: 1, queue: [{ u, d, s }] } (en çok 2.000, URL ≤ 512); bitince null
  frontier     Json?
  // { statuses, newUrls, redirected, blockedByRobots, outOfScope, otherHosts,
  //   throttled, knownNowRedirect, knownRefetched, droppedFrontier, longUrls }
  stats        Json?

  site SeoSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([projectId, startedAt])
  @@index([siteId, kind, status])
}

// Sitenin URL envanteri ve her URL'nin son taranmış hali (sayfa metni
// saklanmaz; yalnız özet ve parmak izi).
model SeoPage {
  id            String @id @default(cuid())
  siteId        String
  workspaceId   String
  projectId     String
  url           String
  // sha256(normalizeCrawlUrl(url)) ilk 32 hex
  urlHash       String
  path          String
  // SEED | CRAWL | SITEMAP | GSC
  discoveredVia String

  lastCrawlId     String?
  // Son adımın durum kodu; yanıt yoksa null
  status          Int?
  // Yanıt alınamadıysa: TIMEOUT | NETWORK | UNSAFE | LOOP | TOO_MANY_REDIRECTS | LEFT_SCOPE | ROBOTS_HOP
  fetchError      String?
  contentType     String?
  finalUrl        String?
  // [{ url, status }] her adım
  redirectChain   Json?
  robotsBlocked   Boolean  @default(false)
  // facts.canonicalResolved ?? ham href
  canonical       String?
  robotsMeta      String?
  xRobotsTag      String?
  noindex         Boolean  @default(false)
  indexable       Boolean?
  title           String?
  metaDescription String?
  h1              String?
  // { h1: string[], h2: string[] }
  headings        Json?
  lang            String?
  // [{ lang, href }]
  hreflang        Json?
  schemaTypes     String[] @default([])
  // string[]
  schemaErrors    Json?
  openGraph       Json?
  // { scripts: string[], styles: string[] } aynı kökten, en çok 20 (ana sayfa)
  assets          Json?
  wordCount       Int?
  textHash        String?
  textSimhash     String?
  contentHash     String?
  inlinks         Int      @default(0)
  outlinks        Int      @default(0)
  depth           Int?
  imagesNoAlt     Int      @default(0)
  bytes           Int?
  ttfbMs          Int?
  renderRisk      Boolean  @default(false)
  mixedContent    Int      @default(0)
  etag            String?
  lastModified    String?
  // [{ code: "TA7", severity }]
  issues          Json?
  // Bir önceki getirmenin kritik alanları { status, fetchError, noindex, canonical, title, finalUrl, at }
  previous        Json?
  // Son başarılı (200, indekslenebilir) hal { title, h1, at } (SH27 eşleştirmesi)
  lastGood        Json?

  inSitemap          Boolean   @default(false)
  sitemapLastmod     DateTime?
  // Taban çizgisi geçişinde null kalır; yalnız sonradan eklenen URL'lerde dolar
  sitemapFirstSeenAt DateTime?
  sitemapLastSeenAt  DateTime?

  lastCrawledAt DateTime?
  lastChangedAt DateTime?
  firstSeenAt   DateTime
  goneAt        DateTime?

  site     SeoSite   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  outLinks SeoLink[] @relation("SeoLinkFrom")

  @@unique([siteId, urlHash])
  @@index([projectId])
  @@index([siteId, lastCrawlId])
  @@index([siteId, inSitemap])
}

// İç link grafiği (yalnız kapsam içi hedefler; sayfa yeniden taranınca
// giden linkleri yeniden yazılır).
model SeoLink {
  id         String  @id @default(cuid())
  siteId     String
  projectId  String
  fromPageId String
  toUrl      String
  toUrlHash  String
  anchor     String?
  nofollow   Boolean @default(false)

  site SeoSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  from SeoPage @relation("SeoLinkFrom", fields: [fromPageId], references: [id], onDelete: Cascade)

  @@index([siteId, toUrlHash])
  @@index([fromPageId])
  @@index([projectId])
}

// Chrome UX Report saha ölçümleri (p75; değerler CrUX'un döndürdüğü gibi).
model SeoCwv {
  id               String   @id @default(cuid())
  siteId           String
  projectId        String
  isMock           Boolean  @default(false)
  // ORIGIN | URL
  scope            String
  target           String
  // PHONE | DESKTOP
  formFactor       String
  // "2026-09-08..2026-10-05"
  collectionPeriod String
  periodEnd        DateTime @db.Date
  // RECORD | HISTORY
  source           String
  lcpP75           Float?
  inpP75           Float?
  clsP75           Float?
  fcpP75           Float?
  ttfbP75          Float?
  // { lcp: [good, ni, poor], ... } yoğunluklar
  histogram        Json?
  fetchedAt        DateTime

  site SeoSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, scope, target, formFactor, collectionPeriod])
  @@index([projectId, periodEnd])
}

// Google arama güncellemeleri takvimi (global; projeye bağlı değil).
model SearchUpdate {
  id              String    @id @default(cuid())
  // Google Search Status Dashboard olay kimliği; elle girilende null
  externalId      String?   @unique
  name            String
  // CORE | SPAM | DISCOVER | REVIEWS | HELPFUL_CONTENT | OTHER_RANKING | SERVING | CRAWLING | INDEXING | OTHER
  kind            String
  // STATUS_DASHBOARD | MANUAL
  source          String
  startedAt       DateTime
  endedAt         DateTime?
  url             String?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([startedAt])
}

// URL Inspection: URL başına son ve önceki indeks durumu (salt okunur API).
model GscUrlInspection {
  id               String    @id @default(cuid())
  linkId           String
  projectId        String
  url              String
  // SeoPage.urlHash ile aynı fonksiyon
  urlHash          String
  // P1 | P2 | P3 | P4 | P5 | P6
  reason           String
  inspectedAt      DateTime
  inspectCount     Int       @default(1)
  // PASS | PARTIAL | FAIL | NEUTRAL | VERDICT_UNSPECIFIED
  verdict          String?
  coverageState    String?
  indexingState    String?
  robotsTxtState   String?
  pageFetchState   String?
  googleCanonical  String?
  userCanonical    String?
  lastCrawlTime    DateTime?
  crawledAs        String?
  sitemaps         String[]  @default([])
  referringUrls    String[]  @default([])
  // { verdict, items: [{ type, issues: [{ severity, message }] }] }
  richResults      Json?
  // { verdict, coverageState, googleCanonical, inspectedAt }
  previous         Json?
  verdictChangedAt DateTime?
  // P6 örneğine girdiği PT haftası (Pazartesi, YYYY-MM-DD)
  sampleWeek       String?

  link GscSiteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, urlHash])
  @@index([linkId, inspectedAt])
  @@index([linkId, sampleWeek])
  @@index([projectId])
}

// Search Console'un sitemap görünümü (sitemaps.list; gönderim yok).
model GscSitemap {
  id             String    @id @default(cuid())
  linkId         String
  projectId      String
  path           String
  type           String?
  isIndex        Boolean   @default(false)
  isPending      Boolean   @default(false)
  lastSubmitted  DateTime?
  lastDownloaded DateTime?
  errors         Int       @default(0)
  warnings       Int       @default(0)
  submittedCount Int       @default(0)
  checkedAt      DateTime

  link GscSiteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, path])
  @@index([projectId])
}

// Haftalık kapsam tahmini (P6 örneklemi, Wilson aralığı).
model GscCoverageWeek {
  id                String   @id @default(cuid())
  linkId            String
  projectId         String
  // PT Pazartesi
  weekStart         DateTime @db.Date
  sampled           Int
  indexed           Int
  crawledNotIndexed Int
  point             Float
  low               Float
  high              Float
  // Sitemap URL sayısı (örneklem havuzu)
  population        Int
  computedAt        DateTime

  link GscSiteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, weekStart])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// SEO fırsat motoru (docs/google-search-console-plan.md SC-F4,
// docs/search-opportunities.md). Bütün tablolar Search Console bağına
// (GscSiteLink) cascade'lidir: Disconnect, "Delete stored data" ve W1 saklama
// temizliği bulguları, kümeleri, embedding'leri ve motor durumunu hemen siler.
// pageId / queryId / clusterId düz kimliktir (W1 sözlüklerine FK yok).
// ---------------------------------------------------------------------------

// Bağ başına motor durumu: kilit, zamanlama, CTR eğrileri, son koşu sayaçları
// ve marka terimi önerileri.
model SeoEngineState {
  id          String  @id @default(cuid())
  workspaceId String
  projectId   String
  linkId      String  @unique
  isMock      Boolean @default(false)

  leaseUntil          DateTime?
  leaseOwner          String?
  // null: hemen aday; her bırakışta ileri bir zaman yazılır
  nextRunAt           DateTime?
  consecutiveFailures Int       @default(0)
  lastError           String?
  lastRunAt           DateTime?
  // Son değerlendirilen tam haftanın Pazartesi'si (PT, YYYY-MM-DD) =
  // GscSiteLink.lastWeeklyWeek
  lastWeek            String?
  // { mode, lowData, evaluated: [], skipped: [{ ruleKey, reason }], fired: { [ruleKey]: n }, dropped, persist: {...}, llmSkipped }
  lastRunStats        Json?
  // { nonBrand: CtrCurve, brand: CtrCurve } (src/lib/seo/ctr-curve.ts)
  curves              Json?
  curvesWeek          String?
  classifiedAt        DateTime?
  // Niyet sınıflamasının dayandığı GscSiteLink.brandClassifiedHash; değişince
  // navigational/marka satırlarının niyeti sıfırlanır
  intentBrandHash     String?
  embeddedAt          DateTime?
  clustersWeek        String?
  explainedWeek       String?
  // { v: 1, items: [{ term, reason, at }], dismissed: string[], lastAt, auto: boolean }
  brandSuggestions    Json?

  link GscSiteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isMock, nextRunAt])
  @@index([projectId])
}

// Fırsat ya da sorun bulgusu (GaFinding alanları + pageId/queryId/clusterId).
model SeoFinding {
  id               String    @id @default(cuid())
  workspaceId      String
  projectId        String
  linkId           String
  // "SO1_STRIKING_DISTANCE" ... "SO16_TECH_IMPACT"
  ruleKey          String
  ruleVersion      Int
  // OPPORTUNITY | RISK | CHANGE | WIN
  kind             String
  // "page:<pageId>", "query:<queryId>", "cluster:<clusterId>", "group:<pageGroup>",
  // "group-schema:<pageGroup>:<type>", "site:<what>", "country:<cc>", "ta:<code>"
  subject          String
  periodStart      DateTime  @db.Date
  periodEnd        DateTime  @db.Date
  // "W:<Pazar>" (haftalık) ya da "M:<ay>" (SO3)
  periodKey        String
  // INFO | WARN | CRITICAL
  severity         String
  // SIGNIFICANT | DIRECTIONAL
  confidence       String
  // OPEN | ACCEPTED | DISMISSED | DONE | EVALUATED | EXPIRED | SUPERSEDED | RESOLVED
  status           String    @default("OPEN")
  // SEO_INSIGHTS=shadow iken üretildi: kullanıcıya gösterilmez
  shadow           Boolean   @default(false)
  // S | M | L | VARIES
  effort           String
  // TITLE_META | CONTENT_REFRESH | NEW_CONTENT | INTERNAL_LINKS | CONSOLIDATE |
  // TECH_FIX | SCHEMA | LOCALIZE | INVESTIGATE
  actionKind       String
  priority         Float     @default(0)
  // Kuralın sabit İngilizce metni (sayılar evidence.metrics'ten; Google
  // dizgisi olarak yalnız keyword ve ana sayfa yolu)
  title            String
  summary          String
  // SeoEvidence (src/lib/seo/opportunity-types.ts)
  evidence         Json
  // { kind: "clicks", perMonth, low, high } | { kind: "reach", impressionsPerMonth }
  impact           Json?
  // LLM; number-check'ten geçmiş, projenin içerik dilinde
  explanation      String?
  explainedAt      DateTime?
  keyword          String?
  ideaWorthy       Boolean   @default(false)
  signalWorthy     Boolean   @default(false)
  fingerprint      String    @unique
  signalId         String?
  ideaIds          String[]  @default([])
  pageId           String?
  queryId          String?
  clusterId        String?
  decidedAt        DateTime?
  decidedByUserId  String?
  // not_relevant | already_done | wrong_data | not_now
  dismissReason    String?
  // Gölge inceleme (operatör, kendi projesinde): USEFUL | NOT_USEFUL
  review           String?
  reviewedAt       DateTime?
  reviewedByUserId String?
  evaluateAfter    DateTime?
  evaluatedAt      DateTime?
  outcome          String?
  lastSeenAt       DateTime

  link GscSiteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
  @@index([linkId, status])
  @@index([linkId, ruleKey, subject])
  @@index([shadow, createdAt])
  @@index([createdAt])
}

// Konu kümesi; üyelik GscQuery.clusterId'dedir (W1 sütunu).
model SeoCluster {
  id             String   @id @default(cuid())
  workspaceId    String
  projectId      String
  linkId         String
  name           String
  // LLM | TOP_QUERY
  nameSource     String
  pillarPageId   String?
  queryCount     Int      @default(0)
  impressions28d Int      @default(0)
  clicks28d      Int      @default(0)
  // Gösterime göre ilk 10 üye (GscQuery kimlikleri)
  topQueryIds    String[] @default([])
  // ACTIVE | STALE
  status         String   @default("ACTIVE")
  // Son hesaplandığı hafta (Pazartesi, PT)
  week           String

  link GscSiteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([linkId, status])
  @@index([projectId])
}

// Sorgu başına bir kez hesaplanan embedding (SK13); Float32 LE baytları.
model SeoQueryEmbedding {
  id        String   @id @default(cuid())
  linkId    String
  projectId String
  queryId   String   @unique
  model     String
  dims      Int
  vector    Bytes
  createdAt DateTime @default(now())

  link GscSiteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// SEO raporları ve planlama (docs/google-search-console-plan.md SC-F5,
// docs/search-reports.md). Bütün tablolar Search Console bağına (GscSiteLink)
// cascade'lidir: Disconnect, "Delete stored data" ve W1 saklama temizliği
// raporları, rapor durumunu ve hedef ilerlemesini hemen siler. ProjectGoal'a
// ilişki eklenmez (goalId düz kimliktir; hedefin modu ProjectGoal.isMock'tadır).
// ---------------------------------------------------------------------------

// Gönderilmiş rapor: değişmez anlık görüntü. Yazıldıktan sonra hiçbir alanı
// güncellenmez (updatedAt yok); yalnız silinir.
model SeoReport {
  id            String   @id @default(cuid())
  workspaceId   String
  projectId     String
  linkId        String
  // PULSE | WEEKLY | MONTHLY | ROADMAP
  kind          String
  // "D:<gün>" | "W:<Pazartesi>" | "M:<YYYY-MM>" (ROADMAP: planlanan ay)
  periodKey     String
  periodStart   DateTime @db.Date
  periodEnd     DateTime @db.Date
  // Rapor yazılırken kesinleşen son PT günü (YYYY-MM-DD)
  finalThrough  String
  // Anlatının dili (Project.language || "tr", ReasoningService ile aynı)
  language      String
  title         String
  // SeoReportSnapshot (src/lib/seo/reports/types.ts)
  snapshot      Json
  // Number-check'ten geçmiş anlatı (ReportSummary) ya da null
  narrative     Json?
  // Anlatı yoksa nedeni (sabit İngilizce metin)
  narrativeNote String?
  // Sohbete yazılan Command'ın deterministik kimliği
  // (seoweekly_<linkId>_<hafta> ...; bağ kimliği mock/canlı ve yeniden
  // bağlanmayı ayırır)
  commandId     String   @unique
  isMock        Boolean  @default(false)
  createdAt     DateTime @default(now())

  link GscSiteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, kind, periodKey])
  @@index([projectId, isMock, createdAt])
  @@index([kind, createdAt])
}

// Bağ başına rapor zamanlayıcısının durumu (kilit, son işlenen dönemler,
// bekleme anları, geri çekilme).
model SeoReportState {
  id          String  @id @default(cuid())
  workspaceId String
  projectId   String
  linkId      String  @unique
  isMock      Boolean @default(false)

  leaseUntil DateTime?
  leaseOwner String?

  // Son işlenen dönemler (PT gün anahtarları, YYYY-MM-DD): nabız günü,
  // haftanın Pazartesi'si, ayın ilk günü, yol haritasının ayı, hedeflerin
  // ölçüldüğü son kesin gün
  pulseDay       String?
  // Son nabız denetimi (yeni CRITICAL uyarı sayımı bu andan itibaren)
  pulseCheckedAt DateTime?
  weeklyWeek     String?
  monthlyMonth   String?
  roadmapMonth   String?
  goalsDay       String?

  // "wait" sonucu: bu dönem için bir sonraki denetim anı (proje saatinde
  // Çarşamba/Perşembe 09:00 ya da ayın 4'ü 09:00, UTC'ye çevrilmiş)
  weeklyWaitWeek   String?
  weeklyWaitUntil  DateTime?
  monthlyWaitMonth String?
  monthlyWaitUntil DateTime?

  nextRunAt           DateTime?
  consecutiveFailures Int       @default(0)
  lastError           String?

  link GscSiteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([isMock, nextRunAt])
}

// SEO hedefinin (ProjectGoal, metricKey SEO_GOAL_METRIC_KEYS'ten biri) günlük
// ölçümü ve temposu. ProjectGoal.currentValue ile aynı değer burada tarih ve
// seriyle tutulur. Hedef tek moda aittir (ProjectGoal.isMock), bu yüzden
// goalId tekildir.
model SeoGoalProgress {
  id              String  @id @default(cuid())
  workspaceId     String
  projectId       String
  linkId          String
  // ProjectGoal.id (FK yok)
  goalId          String  @unique
  metricKey       String
  value           Float?
  // Değerin dayandığı son kesin PT günü
  measuredThrough String?
  // achieved | on_track | behind | at_risk | unknown
  pace            String  @default("unknown")
  // 13 hafta sonrası tahmini ve %90 aralığı
  projected       Float?
  projectedLow    Float?
  projectedHigh   Float?
  // [{ week: "YYYY-MM-DD", value: number }] en çok 13 nokta, eskiden yeniye
  series          Json?
  // no_value | no_target | short_history | no_brand_split | no_health | no_cwv
  reason          String?
  isMock          Boolean @default(false)

  link GscSiteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, isMock])
  @@index([linkId])
}

// ---------------------------------------------------------------------------
// Öneri → uygulama → ölçüm döngüsü (docs/google-search-console-plan.md SC-F6,
// docs/search-actions.md). Bir SEO değişikliğinin önerisi, kullanıcının
// uygulaması, tarayıcımızla doğrulanması ve kontrol gruplu değerlendirmesi.
// linkId / findingId / pageId / creativeId / commandId / workId düz kimliktir
// (FK yok). linkId dolu satırlar Search Console verisi taşır: Disconnect,
// "Delete stored data", W1 saklama temizliği ve bağı kalmayan satır temizliği
// onları (ve türeyen SEO öğrenmelerini) bayraktan bağımsız hemen siler
// (src/server/seo/actions/forget.ts, retention.ts).
// ---------------------------------------------------------------------------
model SeoAction {
  id          String  @id @default(cuid())
  workspaceId String
  projectId   String
  isMock      Boolean @default(false)

  // Bulgu/Done kaynaklı eylemde bulgunun bağı; diğerlerinde oluşturulduğu
  // anda projenin aynı kipteki birincil GscSiteLink'i (yoksa null; ölçüme
  // geçişte bağ varsa doldurulur). SEO kaynaklı sağlık uyarılarında null.
  linkId    String?
  findingId String?
  // FINDING | SEO_MANAGER | HEALTH_ISSUE | OPPORTUNITY_DONE
  source    String
  // TITLE_META | CONTENT_REFRESH | NEW_CONTENT | LOCALIZE | INTERNAL_LINKS |
  // CONSOLIDATE | TECH_FIX | SCHEMA | CWV_FIX | SITEMAP_FIX
  kind      String
  // Açık eylemin tekil anahtarı: "finding:<id>" | "card:<commandId>" |
  // "alert:<dedupeKey>"; eylem sonuçlanınca (terminal durum) null olur
  openKey   String?

  // GscPage.id (birincil hedef sayfa)
  pageId        String?
  targetUrl     String?
  // crawlUrlHash(normalizeCrawlUrl(targetUrl)): SeoPage/GscUrlInspection
  // anahtarı; GscPage.urlHash ile KARŞILAŞTIRILMAZ
  targetUrlHash String?
  // GscQuery kimlikleri (en çok 10)
  targetQueries String[] @default([])
  // SeoActionProposalStored (src/lib/seo/actions/types.ts)
  proposal      Json
  // Değişiklik öncesi sayfa (PageSnapshot), kendi tarayıcımızdan
  baseline      Json?

  // PROPOSED | ACCEPTED | APPLIED | VERIFIED | EVALUATING | WORKED | DIDNT |
  // INCONCLUSIVE | DISMISSED | EXPIRED
  status          String    @default("PROPOSED")
  // USER | DETECTED | CMS
  appliedVia      String?
  appliedAt       DateTime?
  appliedByUserId String?
  verifiedAt      DateTime?
  // SeoVerification (tarayıcı kontrolleri + URL Inspection kanıtı)
  verification    Json?
  verifyAttempts  Int       @default(0)
  // Doğrulanamayınca (türe göre 14/21/35 gün) kullanıcıya soruldu
  askedAt         DateTime?
  // Doğrulayıcı / değerlendiricinin bir sonraki bakış anı
  nextCheckAt     DateTime?
  leaseUntil      DateTime?
  leaseOwner      String?

  windowDays    Int
  // Ölçüm çapası (measuringFields): ölçüme geçerken bir kez yazılır;
  // değerlendirici pencereleri yalnız bundan kurar
  measureFrom   DateTime?
  evaluateAfter DateTime?
  evaluatedAt   DateTime?
  // SeoEvaluation (öncesi/sonrası, kontrol grubu, etki, aralık, güncelleme çakışması)
  evaluation    Json?
  // WORKED | DIDNT | INCONCLUSIVE
  outcome       String?
  // SIGNIFICANT | DIRECTIONAL
  confidence    String?
  // Yazılan BrandLearning.id (yalnız kapıyı geçen sonuçlar)
  learningId    String?

  // SEO Manager makalesi (seo.article Creative), kartın Command'ı ve Work'ü
  creativeId      String?
  commandId       String?
  workId          String?
  // SC-F8 CMS yazmaları için ayrıldı
  approvalId      String?
  createdByUserId String?
  decidedAt       DateTime?
  dismissReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, isMock, openKey])
  @@index([projectId, status])
  @@index([status, evaluateAfter])
  @@index([isMock, status, nextCheckAt])
  @@index([linkId])
  @@index([findingId])
  @@index([commandId])
}

// ---------------------------------------------------------------------------
// SC-F7: aylık SEO içerik planı (migration 20261006220000_add_seo_content_plan)
// ---------------------------------------------------------------------------

// Bağ başına ay başına bir plan. Google'dan türeyen gerekçe (sorgular, gösterim
// payları, boşluklar) yalnız data içindedir; GscSiteLink silinince (Disconnect,
// "Delete stored data", W1 saklama) cascade ile gider.
model SeoContentPlan {
  id             String  @id @default(cuid())
  workspaceId    String
  projectId      String
  linkId         String
  isMock         Boolean @default(false)
  // Projenin yerel ayı: "2026-10"
  month          String
  // ACTIVE (en az bir slot yazıldı) | EMPTY (slot yok; data.reason nedeni söyler)
  status         String  @default("ACTIVE")
  // Planlandığı andaki aylık sınır ve o ayda zaten var olan makale sayısı
  cap            Int
  existingAtPlan Int     @default(0)
  // GscSiteLink.lastWeeklyWeek (Pazartesi, PT): planın dayandığı veri haftası
  basedOnWeek    String
  // AI | BASIC | MOCK
  wording        String  @default("BASIC")
  // "Refresh plan" sayısı (en çok 3)
  regenerations  Int     @default(0)
  // SeoContentPlanData (src/lib/seo/content-plan/types.ts): slotlar, pillar
  // haritası, reddedilenler, nedenler
  data           Json

  link GscSiteLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([linkId, month])
  @@index([projectId, month])
  @@index([isMock, month])
}

// Proje başına SEO içerik planı ayarı (Google verisi değildir; Disconnect'te
// silinmez, yalnız proje silinirken forgetSeoContentPlansForProjects siler).
// Satır yoksa varsayılanlar geçerlidir (sınır 4, otomatik plan açık).
model SeoContentSetting {
  id              String   @id @default(cuid())
  workspaceId     String
  projectId       String   @unique
  // 1..12 (varsayılan 4; SK14 a)
  monthlyCap      Int      @default(4)
  // Her ay kendiliğinden plan çıkar
  autoPlan        Boolean  @default(true)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================================
// SC-F8 (migration 20261006221000_add_seo_apply)
// docs/website-apply.md, docs/wordpress-plan.md, docs/ai-search-visibility.md
// NO existing model changes. Relations only between the new CmsSite and SeoChange.
// ============================================================================

// SC-F8: projenin bagli CMS sitesi (simdilik WordPress). Kimlik bilgisi
// IntegrationCredential'da (provider "wordpress"; mock kipinde "wordpress_mock"),
// sifreli; burada yalniz site durumu, algilanan SEO eklentisi ve yetenekler durur.
// Disconnect satiri siler, SeoChange satirlari cascade ile gider (once
// cleanupSeoApplyForSite).
model CmsSite {
  id          String  @id @default(cuid())
  workspaceId String
  projectId   String
  isMock      Boolean @default(false)

  // WORDPRESS (ileride SHOPIFY | WEBFLOW)
  kind          String
  // IntegrationCredential.id (duz kimlik, FK yok)
  credentialId  String
  // Kanonik koken, yol yok: "https://www.example.com"
  origin        String
  // pretty: {origin}/wp-json/...   query: {origin}/?rest_route=/...
  restMode      String    @default("pretty")
  siteName      String?
  // SeoSite kapsam anahtari (CrawlScope.key) baglanma aninda; degisirse yazma durur (scope_changed)
  scopeKey      String?
  // YOAST | RANK_MATH | NONE
  seoPlugin     String    @default("NONE")
  // { plugin, titleVia, descriptionVia, verifiable } (SeoFieldsCapability)
  seoFields     Json?
  // { draftPosts, publishPosts, editPublishedPosts, editPages, editPublishedPages, editOthers, deletePosts } (WpCapabilities)
  capabilities  Json?
  // OK | LIMITED | AUTH | NO_PERMISSION | UNREACHABLE | NOT_WORDPRESS | REST_BLOCKED | DOMAIN_MISMATCH | UNKNOWN
  health        String    @default("UNKNOWN")
  healthReason  String?
  lastCheckedAt DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  changes SeoChange[]

  @@unique([projectId, kind, isMock])
  @@index([credentialId])
  @@index([projectId])
}

// SC-F8: siteye yazilan her degisikligin kaydi (onay, uygulama, geri okuma,
// geri alma). before/after/params musterinin kendi sayfa icerigidir (baslik,
// aciklama, baglanti metni, iceride ham icerik); Google verisi degildir.
// Metin yuklu alanlar Disconnect'te cascade ile silinir; 24 ay sonra temizlenir.
model SeoChange {
  id          String  @id @default(cuid())
  workspaceId String
  projectId   String
  siteId      String
  isMock      Boolean @default(false)

  // PUBLISH_ARTICLE | PUBLISH_LIVE | TITLE_META | INTERNAL_LINKS
  kind   String
  // PROPOSED | APPROVED | APPLYING | APPLIED | VERIFIED | FAILED | UNDOING | UNDONE | REJECTED | EXPIRED
  status String @default("PROPOSED")
  // ARTICLE | ACTION | DRAFT
  source String
  // Sabit Ingilizce baslik (en cok 80 karakter; URL ve makale basligi icermez)
  title  String

  // WordPress hedefi (PUBLISH_ARTICLE'da uygulama sonrasi dolar)
  targetUrl String?
  // post | page
  wpType    String?
  wpId      Int?
  // Herkese acik adres (taslakta null); IndexNow ve arayuz icin
  liveUrl   String?

  // Dogrulanmis girdi: SeoChangeParams (kind dahil)
  params Json
  // Uygulamadan hemen once canli okunan ve geri okunan durum: WpSnapshot.
  // before ilk denemede saklanir ve sonraki denemelerde "onceki durum" olarak okunur.
  before Json?
  after  Json?

  // Ayni (site, tur, konu) icin tek acik degisiklik
  dedupeKey String
  openKey   String?
  // Zaten saglanmisti: yazma yapilmadi, geri alinamaz. Onceki denememizin yazisi
  // inmisse (landedEarlier) false kalir: sayilir, geri alinabilir.
  noop      Boolean @default(false)

  // Baglantilar (duz kimlik, FK yok). creativeId PUBLISH_ARTICLE ve PUBLISH_LIVE'da dolar.
  seoActionId String?
  creativeId  String?
  taskId      String?
  approvalId  String?

  // USER (SC-F8'de SYSTEM onerisi yok)
  proposedByType   String
  proposedByUserId String?
  approvedByUserId String?
  undoneByUserId   String?

  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  leaseUntil    DateTime?
  leaseOwner    String?
  // Approval.expiresAt ile ayni deger (tek kez hesaplanir)
  expiresAt     DateTime

  approvedAt   DateTime?
  appliedAt    DateTime?
  verifiedAt   DateTime?
  rolledBackAt DateTime?
  failedAt     DateTime?
  // { code, message, retryable?, undo? }: sabit metin, WordPress ham hatasi yok
  error        Json?
  // { state: PENDING | SENT | SKIPPED | FAILED, at, urls }
  indexNow     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site CmsSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, openKey])
  @@index([projectId, createdAt])
  @@index([siteId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([taskId])
  @@index([approvalId])
  @@index([seoActionId])
  @@index([creativeId])
}

// SC-F8: proje basina uygulama ayarlari (gunluk sinir, IndexNow). Google verisi yok.
model SeoApplySetting {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String @unique

  // Kayan 24 saatte en cok uygulanacak degisiklik (1..25)
  dailyLimit Int @default(10)

  indexNowEnabled    Boolean   @default(false)
  // Herkese acik anahtar (dosya adi ve icerik); gizli degildir
  indexNowKey        String?
  indexNowHost       String?
  indexNowVerifiedAt DateTime?
  indexNowLastPingAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

