model AutonomyPolicy {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String @unique
  brandId     String

  setupAutoApprove Boolean @default(false)

  // Unlimited mode: disables the daily counter and budget caps. Counters
  // are still processed (so telemetry doesn't break), only the threshold
  // check is skipped. A separate flag instead of deleting the limits: when
  // turned off, the old caps come back exactly as they were.
  unlimitedMode Boolean @default(false)

  maxTasksPerDay             Int @default(25)
  maxReasoningCallsPerDay    Int @default(200)
  maxConcurrentResearchTasks Int @default(5)
  maxOpenOpportunities       Int @default(30)
  maxActiveIdeas             Int @default(20)

  // Backpressure cap read by AgencyDirector.decideOnIdea and
  // WorkHandoffEngine.accept via TaskRepository.countActiveSystemTasks —
  // caps how much SYSTEM-created work can be in flight at once for a
  // project, independent of the daily counter caps above.
  maxConcurrentSystemTasks Int @default(15)

  dailyBudgetUsd    Float?
  taskCooldownHours Int    @default(72)

  // Hard ceiling for a single autonomously-proposed Meta ad campaign's
  // daily budget (see agency/meta-ads — the LLM-proposed dailyBudgetCents
  // is clamped to this before the campaign task is ever planned, so an
  // approver always sees a bounded number regardless of what the model
  // suggested). Dollars, same unit as dailyBudgetUsd above.
  maxCampaignDailyBudgetUsd Float @default(10)

  scoringWeights    Json?
  approvalOverrides Json?

  // The spec's simplified 3-mode trust dial (docs/brand-workspace-migration.md
  // §7 Phase 7) — deliberately NOT a new parallel approval system: it only
  // governs whether an autonomously-created Creative (today: only
  // instagram-week-planner.ts's weekly auto-planner) lands pre-approved or
  // waits in the SAME IN_REVIEW/Approval flow every human-triggered
  // creative already goes through. Default AUTOPILOT preserves today's
  // exact behavior for every existing project (no regression on migrate).
  autopilotMode AutopilotMode @default(AUTOPILOT)

  // Faz 5 (docs/brand-brain-loop.md): once the Sunday weekly draft (above)
  // has sat untouched for a while, prepare it automatically — save it and
  // start production — so the owner finds pieces waiting to approve instead
  // of an empty draft. Independent of autopilotMode (never reused for this:
  // see weekly-plan-draft.ts's header comment on why that field is already
  // spoken for). Default off: an existing project opts in explicitly: this
  // spends real money unattended, which "Weekly plan draft" alone does not.
  weeklyAutoProduce Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

enum AutopilotMode {
  // Agentelse creates work; nothing is scheduled until a human reviews it.
  REVIEW_EVERYTHING
  // Agentelse creates AND schedules work, but still asks before it's
  // eligible to publish (lands at IN_REVIEW, pre-scheduled).
  CREATE_AUTOMATICALLY
  // Agentelse creates, schedules and publishes within configured caps —
  // today's existing default behavior.
  AUTOPILOT
}

enum AgencyLoopStatus {
  RUNNING
  WAITING
  BLOCKED
  PAUSED
  ERROR
}

enum AgencyCycleStatus {
  RUNNING
  COMPLETED
  NOOP
  FAILED
}

// Control/telemetry state for whether a project's agency loop is actually
// operating — NOT an alternative task queue (Task/ExecutionJob/AgencyTrigger
// remain the only work items). One row per project. Previously the only
// signal of "is this project's agency active" was Project.status, which
// only one engine (SignalUniverse.runDueScans) ever actually checked — this
// gives every other engine/the UI a single place to read/set it.
model AgencyLoopState {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String @unique
  brandId     String

  status AgencyLoopStatus @default(RUNNING)

  startedAt      DateTime  @default(now())
  lastTickAt     DateTime?
  lastProgressAt DateTime?
  nextWakeAt     DateTime?

  currentPhase    String?
  lastTriggerType AgencyTriggerType?
  blockedReason   String?

  consecutiveNoProgressCycles Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

// Append-only per-cycle telemetry — mainly operational/UI support (spec:
// "why did it wake up, what did it decide, what work did it create"), NOT a
// duplicate context store. One row per AgencyTrigger processed (triggerType/
// triggerId identify which); the count fields are best-effort snapshots of
// what that specific cycle did, distinct from AgencyDailyStat's per-day
// running totals (tasksCreated etc. there are already wired into
// AutonomyPolicyRepository.checkAndIncrement).
model AgencyCycle {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  triggerType AgencyTriggerType?
  triggerId   String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      AgencyCycleStatus @default(RUNNING)

  signalsProcessed     Int @default(0)
  insightsCreated      Int @default(0)
  opportunitiesCreated Int @default(0)
  ideasCreated         Int @default(0)
  decisionsCreated     Int @default(0)
  tasksCreated         Int @default(0)
  handoffsCreated      Int @default(0)
  measurementsCreated  Int @default(0)
  learningsCreated     Int @default(0)

  errorCount Int @default(0)

  @@index([projectId, startedAt])
}

model AgencyDailyStat {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  date DateTime @db.Date

  tasksCreated         Int @default(0)
  reasoningCalls       Int @default(0)
  signalsIngested      Int @default(0)
  opportunitiesCreated Int @default(0)
  ideasCreated         Int @default(0)

  reasoningCostUsd Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, date])
  @@index([projectId])
}

model ReasoningCall {
  id          String  @id @default(cuid())
  workspaceId String
  projectId   String?
  brandId     String?

  purpose String
  model   String
  isMock  Boolean

  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  durationMs   Int

  status       String
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([purpose])
  // Scanners: a project's latest call of one purpose.
  @@index([projectId, purpose, createdAt])
}

// =============================================================================
// META ADS (docs/meta-ads-plan.md §4)
// =============================================================================
// Yeni reklam tabloları `Ads*` önekini ve `platform` alanını taşır (şimdilik
// yalnız META). Para alanları reklam hesabının minor unit'idir
// (src/lib/ads/money.ts). Tablolar düz `projectId` taşır; ProjectDeletionService
// onları kendiliğinden siler.

enum AdsPlatform {
  META
}

enum AdsOperationStatus {
  PENDING
  SENT
  SUCCEEDED
  UNKNOWN
  RECONCILED
  FAILED
  COMPENSATED
}

// Workspace'te bağlı bir Meta reklam hesabının tek kaydı: sağlık, kota ve
// senkron durumu. Meta kotası reklam hesabı (`act_`) başınadır; aynı hesap
// birden çok projeye bağlıysa satır tektir, projeler AdsAccountProject'tedir.
model AdsAccount {
  id           String      @id @default(cuid())
  workspaceId  String
  credentialId String?
  platform     AdsPlatform @default(META)
  // "act_<id>"
  externalId   String
  name         String?
  currency     String?
  timezoneName String?

  // Meta account_status (1 = ACTIVE) ve disable_reason (0 = yok).
  accountStatus Int?
  disableReason Int?
  hasFunding    Boolean?
  isPersonal    Boolean?

  spendCapMinor            BigInt?
  amountSpentMinor         BigInt?
  minDailyBudgetMinor      BigInt?
  minCampaignSpendCapMinor BigInt?
  minimumBudgets           Json?
  userTasks                String[] @default([])
  businessId               String?
  pageId                   String?
  instagramUserId          String?
  dsaBeneficiary           String?
  dsaPayor                 String?
  // development_access / standard_access (başlıktan okunur).
  accessTier               String?

  // Governor (src/server/integrations/meta/governor.ts): Meta'nın kullanım
  // başlıklarından son okunan değerler ve blok süresi. Durum süreçte değil
  // burada tutulur: deploy örtüşmesindeki iki kopya aynı kovayı görür.
  lastUsage        Json?
  rateLimitedUntil DateTime?

  // OK | WARN | BLOCKED | AUTH | UNKNOWN
  healthStatus String    @default("UNKNOWN")
  healthReason String?
  lastHealthAt DateTime?

  lastStructureAt     DateTime?
  lastInsightsAt      DateTime?
  lastBackfillDate    String?
  syncLeaseUntil      DateTime?
  syncLeaseOwner      String?
  consecutiveFailures Int       @default(0)

  projects AdsAccountProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, platform, externalId])
  @@index([externalId])
  @@index([syncLeaseUntil])
}

// Hesap ↔ proje bağlantısı. v1'de proje başına tek seçili hesap (K10);
// tablo çoklu hesaba hazırdır.
model AdsAccountProject {
  id           String     @id @default(cuid())
  adsAccountId String
  projectId    String
  brandId      String
  selected     Boolean    @default(false)
  adsAccount   AdsAccount @relation(fields: [adsAccountId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([adsAccountId, projectId])
  @@index([projectId, selected])
}

// Her Meta yazmasının niyet ve denetim kaydı (docs/meta-ads-plan.md §3.1
// Idempotency). Meta istemci tarafı idempotency anahtarı sunmaz: yazmadan önce
// bu satır açılır, `tag` nesne adına eklenir; zaman aşımında kör tekrar
// yapılmaz, önce etiketle Meta'da aranır. Token asla saklanmaz.
model AdsOperation {
  id               String             @id @default(cuid())
  workspaceId      String
  projectId        String
  adsAccountId     String?
  // "act_<id>": kota ve uzlaştırma için.
  adAccountExternalId String?
  // CREATE_CAMPAIGN, CREATE_ADSET, CREATE_CREATIVE, CREATE_AD, UPDATE_CAMPAIGN,
  // UPDATE_ADSET, UPDATE_AD, SET_STATUS...
  kind             String
  // "agx:k3f9q2" — Meta'da uzlaştırma anahtarı.
  tag              String             @unique
  launchId         String?
  decisionId       String?
  executionJobId   String?
  // USER | SYSTEM | RULE
  actorType        String
  // Yazmanın hedefi (güncellemede nesne, oluşturmada ebeveyn kenarı).
  targetExternalId String?
  parentExternalId String?
  request          Json
  previousState    Json?
  status           AdsOperationStatus @default(PENDING)
  resultExternalId String?
  // code, subcode, class, userMessage, blameFieldSpecs, fbtraceId
  error            Json?
  attempts         Int                @default(0)
  sentAt           DateTime?
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([executionJobId, kind])
  @@index([projectId, createdAt])
  @@index([status, sentAt])
  @@index([adAccountExternalId, createdAt])
}

enum AdsLevel {
  ACCOUNT
  CAMPAIGN
  ADSET
  AD
}

enum AdsAlertStatus {
  OPEN
  ACKED
  RESOLVED
  MUTED
}

enum AdsSeverity {
  INFO
  WARN
  CRITICAL
}

// Kampanya / ad set / reklam aynası (docs/meta-ads-plan.md §3.2). Ekranlar,
// sohbet ve kurallar canlı Graph yerine buradan okur. `goneAt`: Meta listesinde
// artık görünmeyen (arşivlenmiş ya da silinmiş) nesne; harcaması kimlikle
// okunmaya devam eder.
model AdsObject {
  id                   String    @id @default(cuid())
  adsAccountId         String
  projectId            String?
  level                AdsLevel
  externalId           String
  parentExternalId     String?
  campaignExternalId   String?
  name                 String
  objective            String?
  optimizationGoal     String?
  billingEvent         String?
  bidStrategy          String?
  destinationType      String?
  configuredStatus     String?
  effectiveStatus      String?
  dailyBudgetMinor     BigInt?
  lifetimeBudgetMinor  BigInt?
  spendCapMinor        BigInt?
  budgetRemainingMinor BigInt?
  startTime            DateTime?
  endTime              DateTime?
  learningStatus       String?
  learningConversions  Int?
  lastSigEditAt        DateTime?
  issues               Json?
  reviewFeedback       Json?
  failedDeliveryChecks Json?
  advantageState       String?
  resultActionType     String?
  creativeExternalId   String?
  thumbnailAssetId     String?
  thumbnailFetchedAt   DateTime?
  // 7 ve 28 günlük tekil kişi metrikleri (erişim, sıklık); günlük satırlardan
  // toplanamaz.
  windowStats          Json?
  createdByAgentelse   Boolean   @default(false)
  launchId             String?
  // İzlenen alanların özeti: değişirse drift denetlenir.
  fieldsHash           String?
  metaUpdatedAt        DateTime?
  lastSeenAt           DateTime?
  lastDeliveryAt       DateTime?
  driftAt              DateTime?
  goneAt               DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([adsAccountId, externalId])
  @@index([projectId, level, effectiveStatus])
  @@index([adsAccountId, level])
}

// Günlük performans (hesap gününe göre). Para alanları hesabın minor
// unit'idir. Reklam düzeyi 180 gün, diğer düzeyler 400 gün saklanır (K7).
model AdsInsightDaily {
  id                 String   @id @default(cuid())
  adsAccountId       String
  projectId          String?
  level              AdsLevel
  // ACCOUNT için "act_<id>"
  externalId         String
  date               DateTime @db.Date
  spendMinor         BigInt   @default(0)
  impressions        Int      @default(0)
  reach              Int      @default(0)
  frequency          Float?
  clicks             Int      @default(0)
  linkClicks         Int      @default(0)
  landingPageViews   Int      @default(0)
  // Meta'nın `results` alanından (ya da hedefe göre yedek eşlemeden).
  results            Int?
  resultActionType   String?
  actionValuesMinor  BigInt?
  actions            Json?
  video3s            Int?
  thruplays          Int?
  rankings           Json?
  attributionSetting String?
  // 28 günden eski satır artık yeniden çekilmez.
  isFinal            Boolean  @default(false)
  fetchedAt          DateTime @default(now())

  @@unique([adsAccountId, level, externalId, date])
  @@index([projectId, date])
  @@index([adsAccountId, date])
}

// Tekilleştirilmiş reklam uyarısı (docs/meta-ads-plan.md §3.6). Koşul tekrar
// ederse aynı satır yeniden açılır; düzelince kendiliğinden RESOLVED olur.
// LLM puanlamasından geçmez.
model AdsAlert {
  id             String         @id @default(cuid())
  workspaceId    String
  projectId      String
  adsAccountId   String?
  externalId     String?
  kind           String
  severity       AdsSeverity
  status         AdsAlertStatus @default(OPEN)
  dedupeKey      String
  title          String
  detail         String?
  data           Json?
  firstSeenAt    DateTime       @default(now())
  lastSeenAt     DateTime       @default(now())
  occurrences    Int            @default(1)
  notifiedAt     DateTime?
  notifyChannels String[]       @default([])
  mutedUntil     DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([projectId, dedupeKey])
  @@index([projectId, status, severity])
}

// Lansman durumu (docs/meta-ads-plan.md §3.4).
enum AdsLaunchStatus {
  DRAFT
  MEDIA_PROCESSING
  VALIDATED
  AWAITING_APPROVAL
  CREATING
  CREATED_PAUSED
  ACTIVATING
  ACTIVE
  FAILED
  EXPIRED
  CANCELLED
  DISCARDING
  DISCARDED
}

// Bir lansmanın tek kaydı (F3). Kart yalnız launchId tutar; durum, ilerleme
// (kurulan nesnelerin kimlikleri) ve Meta'nın ön kontrol sonuçları buradadır.
// Her deneme ("Fix and retry", "Turn on", "Discard") ayrı bir META_LAUNCH
// görevidir ve aynı kayda bağlanır; başarılı adımlar niyet günlüğünden
// (AdsOperation.launchId) bulunup atlanır.
model AdsLaunch {
  id                  String          @id @default(cuid())
  workspaceId         String
  projectId           String
  workId              String?
  // Lansmanı açan kartın Command'ı.
  commandId           String
  launchKey           String
  adsAccountId        String?
  adAccountExternalId String
  status              AdsLaunchStatus @default(DRAFT)
  specVersion         Int             @default(1)
  spec                Json
  // Onayın geçerliliği: bütçe, hedefleme, amaç ya da kimlik değişirse değişir.
  specHash            String
  // Yerel doğrulama, Meta validate_only sonuçları ve önizlemeler.
  validation          Json?
  approvalId          String?
  activationApprovalId String?
  currentTaskId       String?
  // create | activate | discard
  mode                String?
  campaignExternalId  String?
  // Adım sonuçları: görsel hash'leri, kreatif / ad set / reklam kimlikleri.
  progress            Json?
  envelope            Json?
  // Meta tarafı frenler: kampanya spend_cap, ad set end_time (geri okunmuş).
  guards              Json?
  error               Json?
  // Adım makinesinin kilidi: işçi ve satır içi sürüş aynı anda yazmaz.
  leaseUntil          DateTime?
  leaseOwner          String?
  createdByUserId     String?
  activatedAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([commandId, launchKey])
  @@index([projectId, status])
  @@index([status, updatedAt])
}

// Optimizasyon kararının durumu (docs/meta-ads-plan.md §3.5).
enum AdsDecisionStatus {
  SHADOW
  PROPOSED
  APPROVED
  REJECTED
  EXPIRED
  SUPERSEDED
  APPLYING
  APPLIED
  VERIFIED
  FAILED
  ROLLED_BACK
}

// Reklam otonomisi (F7): Suggest (öneri), Guarded (yalnız riski azaltan
// otomatik), Full (zarf içinde otomatik).
enum AdsAutonomyLevel {
  SUGGEST
  GUARDED
  FULL
}

// Optimizasyon karar kaydı (F4): her değişiklik öneri → onay → uygulama →
// geri okuma → değerlendirme → geri alma zincirini izler. Gölge modda yalnız
// SHADOW yazılır. Kurallar deterministiktir; metin yalnız açıklamadır.
model AdsDecision {
  id           String            @id @default(cuid())
  workspaceId  String
  projectId    String
  adsAccountId String
  level        AdsLevel
  externalId   String
  // "O2_HIGH_CPA"
  ruleKey      String
  ruleVersion  Int
  // PAUSE, BUDGET_DOWN, BUDGET_UP, CREATIVE_REFRESH, ARCHIVE, NOTIFY, ROLLBACK
  kind         String
  severity     AdsSeverity
  status       AdsDecisionStatus
  autonomy     AdsAutonomyLevel  @default(SUGGEST)
  // Pencereler, metrikler, geçen kapılar.
  evidence     Json
  explanation  String
  // { field, from, to }: "from" uygulamada CAS için.
  change       Json?
  // kural + nesne + hafta
  fingerprint  String            @unique
  approvalId   String?
  taskId       String?
  expiresAt    DateTime?
  appliedAt    DateTime?
  verifiedAt   DateTime?
  // Olgunluk gecikmesiyle değerlendirme zamanı.
  evaluateAfter DateTime?
  evaluatedAt  DateTime?
  // WORKED | DIDNT | INCONCLUSIVE
  outcome      String?
  outcomeData  Json?
  rollbackOfId String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([projectId, status])
  @@index([adsAccountId, externalId, ruleKey])
  @@index([status, evaluateAfter])
}
