// =============================================================================
// SCHEDULER
// =============================================================================

model ProjectSchedule {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  name String

  capability     CapabilityKey
  scheduleType   ScheduleType
  cronExpression String?
  // IANA zone the cronExpression's clock time is evaluated in (cron-parser
  // resolves this natively via its bundled luxon dependency, DST included).
  // Null means UTC — every schedule predating this field keeps running
  // exactly as before.
  timezone       String?

  configuration Json?

  enabled   Boolean   @default(true)
  nextRunAt DateTime?
  lastRunAt DateTime?

  // Retry/backoff bookkeeping (docs/brand-workspace-migration.md §7 —
  // reliability audit concern 8): without these, a schedule that throws
  // retried on every single worker tick forever, with no cooldown and no
  // cap. Reset to 0/null on the next successful run; disabled once
  // consecutiveFailures reaches SchedulerService's MAX_ATTEMPTS.
  consecutiveFailures Int     @default(0)
  lastError           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
  @@index([nextRunAt])
  @@index([enabled])
}

