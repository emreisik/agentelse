// Agentelse — Prisma schema
// AI Digital Agency Operating System
//
// Tenant hierarchy: Workspace -> Project (brand/client, e.g. Biduniq) -> Brand
// (most projects have exactly one default Brand; a project may host more than
// one brand identity). workspaceId/projectId/brandId are denormalized onto
// every tenant-scoped table on purpose, so repository-level filters can
// enforce isolation without joining through parents.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

