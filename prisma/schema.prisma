model BrandLearning {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  insight    String
  sourceType String?
  sourceRef  String?
  confidence Float?

  // Brand Workspace's Creative Memory ("what works" / "avoid" — see
  // docs/brand-workspace-migration.md §7 Phase 3): WORKS/AVOID lets the
  // same table serve both sides of that list. A single observation must
  // not silently become a permanent rule — evidenceCount is incremented
  // (not a new row inserted) when a materially similar insight is
  // reobserved, so a learning only counts as reinforced once multiple
  // evidence points agree.
  polarity         LearningPolarity @default(WORKS)
  evidenceCount    Int              @default(1)
  lastReinforcedAt DateTime?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([brandId])
  // Learning engine: a lesson by its source.
  @@index([sourceType, sourceRef])
}

// Brand Workspace's structured preference/decision log (see docs/
// brand-workspace-migration.md §7 Phase 3) — captures a user statement like
// "more premium" as a typed, queryable fact (type/scope/value) instead of
// leaving it recoverable only by re-reading raw chat history. Deliberately
// separate from BrandDecision (agency-authored strategic decisions) and
// AgencyDecision (settings-panel decisions) — this one is always
// user-authored preference/confirmation, scoped freely (e.g. "BRAND",
// "CAMPAIGN:<id>") rather than tied to one entity type.
model UserDecision {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  type  UserDecisionType
  scope String
  value Json

  // The message this was derived from is always kept alongside the
  // structured value — per spec: "Keep the raw conversation message too."
  rawMessage      String?
  sourceCommandId String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([projectId])
  @@index([brandId, type])
}

model BrandStrategyVersion {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  version         Int
  summary         String?
  payload         Json
  createdByUserId String?

  createdAt DateTime @default(now())

  @@unique([brandId, version])
  @@index([projectId])
  @@index([brandId])
}

model BrandEvidence {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  evidenceId        String
  relatedEntityType String
  relatedEntityId   String

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([brandId])
  @@index([relatedEntityType, relatedEntityId])
}

// =============================================================================
// CONTEXT SNAPSHOT
// =============================================================================

model ExecutionContextSnapshot {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  brandBrainVersion    Int?
  strategyVersion      Int?
  negativeBriefVersion Int?

  payload Json
  hash    String

  executionJobs ExecutionJob[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
}

// =============================================================================
// COMMAND / TASK / EXECUTION
// =============================================================================

// One conversation of the Agency Desk (docs/works.md): a titled, channel-scoped
// piece of work the user opens, continues and completes. Chat rows (Command)
// belong to a Work through Command.workId; rows without one are the legacy
// single project chat. Connection status is NOT stored here (it is read live);
// only the channels the user chose to work on.
model Work {
  id              String  @id @default(cuid())
  workspaceId     String
  projectId       String
  createdByUserId String?

  title   String
  // One-line subtitle: the newest card's summary.
  summary String?
  status  WorkStatus @default(ACTIVE)

  // Chosen channel keys (content-channels CHANNEL_KEYS subset), e.g. ["instagram"].
  channels                Json @default("[]")
  // Channel keys chosen while NOT connected ("I'll connect later").
  acknowledgedUnconnected Json @default("[]")

  // The module this Work is for (src/lib/modules/catalog.ts: "social", "ads",
  // "analytics", "seo"). Null = a general chat. A plain string validated in
  // the app, like Creative.channel.
  module String?

  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  commands Command[]
  posts    Post[]

  @@index([projectId, status, lastActivityAt])
  @@index([workspaceId])
}

// One post: ONE idea and ONE picture, delivered to channels (docs/works.md
// "Posts"). Each channel's piece is a Creative with this postId (its
// delivery): its own format, caption, approval and publish state, so the
// publishing code keeps working per delivery. The post's own state is derived
// from its deliveries; only the post-level decisions are stored here.
model Post {
  id          String  @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String
  workId      String?
  // The plan's chat Command (same as Creative.planId, no FK); the pool idea.
  planId      String?
  ideaId      String?

  // THE idea, and its caption idea / master message.
  topic String
  idea  String?
  goal  String?

  // When it goes out (its deliveries carry the same instant), and the zone
  // the plan was drawn in.
  scheduledFor DateTime?
  timezone     String?

  // THE picture: the first one rendered for the post; every other image
  // delivery is this picture adapted to its own format.
  pictureAssetId String?

  // The brand's own photos this post is made from (BrandMedia assets): the
  // picture IS the photo, the app adds the design on it. Empty = generated.
  photoAssetIds String[] @default([])

  approvedAt       DateTime?
  approvedByUserId String?
  archivedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  work       Work?      @relation(fields: [workId], references: [id], onDelete: SetNull)
  deliveries Creative[]

  @@index([projectId, scheduledFor])
  @@index([planId])
  @@index([workId])
}

model Command {
  id          String  @id @default(cuid())
  workspaceId String
  projectId   String?
  brandId     String?
  // Populated when a message belongs to an idea's own chat thread — both
  // the messages the user writes about that idea (source: WEB) and the
  // system messages the agency pipeline (council, work plan, task/creative
  // completion) writes into that idea's thread (source: SYSTEM) accumulate
  // here under the same ideaId — the "everything in one conversation"
  // architecture.
  ideaId      String?
  // A non-idea, non-project-general conversation scope — currently only
  // "BRAND_BRAIN" (brand-brain-chat-service.ts), a project-wide but
  // brand-strategy-focused thread distinct from both an idea's chat and the
  // general project chat (which explicitly excludes topic != null rows, see
  // projects/[projectId]/page.tsx, so the two streams never mix). Kept as a
  // free string rather than an enum so a future second topic doesn't need a
  // migration.
  topic       String?

  source          CommandSource
  rawText         String
  parsedIntent    Json?
  createdByUserId String?

  // Chat turn: files the user attached and the assistant's reply for that
  // turn. attachments = [{ assetId, filename, mimeType, size }].
  attachments Json?
  replyText   String?
  replyStatus String?

  // The Work (conversation) this row belongs to; null = legacy single chat.
  workId String?
  work   Work?   @relation(fields: [workId], references: [id], onDelete: SetNull)

  idea  Idea?  @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  tasks Task[]

  // Read-only copies of parsedIntent.card.{kind,taskId,creativeId}: STORED
  // generated columns (migration 20261007110000), filled by the database
  // itself, so no writer sets them and old rows already have them. They exist
  // so the chat page and the card repositories can use plain indexed
  // equality instead of a JSON-path scan over every row of the project
  // (Prisma sends a path filter as parameters, which no index can serve).
  // Never put them in a create/update `data`.
  cardKind       String? @default(dbgenerated("((\"parsedIntent\" -> 'card'::text) ->> 'kind'::text)"))
  cardTaskId     String? @default(dbgenerated("((\"parsedIntent\" -> 'card'::text) ->> 'taskId'::text)"))
  cardCreativeId String? @default(dbgenerated("((\"parsedIntent\" -> 'card'::text) ->> 'creativeId'::text)"))

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([projectId])
  @@index([createdAt])
  @@index([ideaId])
  @@index([workId, createdAt])
  @@index([topic])
  // Single-chat consolidation: the general-chat query is no longer narrowed
  // by ideaId (it now includes every SYSTEM pipeline event project-wide,
  // not just idea-less ones — see chat-service.ts buildContext / page.tsx),
  // so it needs its own composite index instead of relying on the
  // ideaId-narrowed query being naturally selective.
  @@index([projectId, createdAt])
  // The chat page reads WEB and SYSTEM rows separately, newest first.
  @@index([projectId, source, createdAt])
  @@index([projectId, cardTaskId])
  @@index([projectId, cardCreativeId])
  @@index([projectId, cardKind, createdAt])
}

model Task {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  commandId    String?
  parentTaskId String?

  title       String
  description String?
  // Original command payload (e.g. { request, platform }) — persisted so a
  // task parked behind an Approval can be re-dispatched with the same
  // request details once approved, instead of guessing them from the title.
  payload     Json?

  capability CapabilityKey

  status    TaskStatus   @default(DRAFT)
  priority  TaskPriority @default(MEDIUM)
  riskLevel RiskLevel    @default(LOW)

  createdByType   ActorType
  createdByUserId String?

  requiresApproval     Boolean @default(false)
  requiresVerification Boolean @default(false)

  // Agency OS additions: which department owns this work, which WorkPlan it
  // belongs to, which ProjectGoals it serves, and a dedup fingerprint so the
  // director can refuse to recreate the same work inside a cooldown window.
  departmentKey    DepartmentKey?
  workPlanId       String?
  goalIds          String[]       @default([])
  fingerprint      String?
  sourceDecisionId String?

  command            Command?                   @relation(fields: [commandId], references: [id], onDelete: SetNull)
  parentTask         Task?                      @relation("TaskChildren", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks         Task[]                     @relation("TaskChildren")
  dependsOn          TaskDependency[]           @relation("TaskDependent")
  dependedOnBy       TaskDependency[]           @relation("TaskDependsOn")
  executionJobs      ExecutionJob[]
  approvals          Approval[]
  humanInterventions HumanInterventionRequest[]
  creatives          Creative[]
  workPlan           WorkPlan?                  @relation(fields: [workPlanId], references: [id], onDelete: SetNull)

  dueAt       DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
  @@index([status])
  @@index([capability])
  @@index([createdAt])
  @@index([projectId, status])
  @@index([projectId, fingerprint, createdAt])
  @@index([workPlanId])
  // Plan/package pieces by their plan Command (chat page, journey, plan routes).
  @@index([commandId])
  // Publish tasks per project and window (calendar poll, publish paths).
  @@index([projectId, capability, createdAt])
  @@index([parentTaskId])
  // The chat's progress poll: did any task of the project change since the
  // page was rendered (src/server/chat/progress.ts).
  @@index([projectId, updatedAt])
}

model TaskDependency {
  id              String @id @default(cuid())
  taskId          String
  dependsOnTaskId String

  task          Task @relation("TaskDependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("TaskDependsOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
}

model ExecutionJob {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String
  taskId      String

  capability   CapabilityKey
  providerType ExecutionProviderType
  providerId   String?

  skillId      String?
  skillVersion String?

  browserProfileId String?

  phase  OperationPhase     @default(ACT)
  status ExecutionJobStatus @default(QUEUED)

  correlationId  String @unique
  idempotencyKey String @unique

  // Opaque handle returned by the provider's execute() call, used to poll
  // getStatus()/cancel()/resume() later. Not always equal to correlationId —
  // real providers may mint their own reference.
  providerExecutionReference String?

  contextSnapshotId String?

  requestPayload   Json?
  rawResult        Json?
  normalizedResult Json?

  errorCode    String?
  errorMessage String?
  retryable    Boolean @default(false)

  attemptCount Int @default(0)

  estimatedCost Float?
  actualCost    Float?

  task               Task                       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  browserProfile     BrowserProfile?            @relation(fields: [browserProfileId], references: [id], onDelete: SetNull)
  contextSnapshot    ExecutionContextSnapshot?  @relation(fields: [contextSnapshotId], references: [id], onDelete: SetNull)
  skill              Skill?                     @relation(fields: [skillId], references: [id], onDelete: SetNull)
  outboxEvents       OutboxEvent[]
  deadLetterJobs     DeadLetterJob[]
  verification       ExecutionVerification?
  evidences          Evidence[]
  humanInterventions HumanInterventionRequest[]

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
  @@index([status])
  @@index([capability])
  @@index([createdAt])
  @@index([taskId])
  // Provider health: each provider's results in the last window.
  @@index([providerId, updatedAt])
}

