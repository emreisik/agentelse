model Approval {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  taskId String?

  entityType String
  entityId   String

  type   ApprovalType
  status ApprovalStatus @default(PENDING)

  // Agency OS approval level. Null = legacy row, treated as LEVEL_3_CLIENT.
  level ApprovalLevel?

  requestedByType ActorType
  requestedById   String?

  reviewedByUserId String?
  reviewNote       String?

  // ID of the approval request message in Telegram — used to remove the
  // buttons and update the message after a decision is made.
  telegramMessageId String?

  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
  @@index([status])
  @@index([entityType, entityId])
  // Open approvals of a project, oldest first (every chat page and turn).
  @@index([projectId, status, createdAt])
  @@index([taskId])
}

// =============================================================================
// CREATIVE WORKFLOW / ASSETS
// =============================================================================

enum BrandMediaKind {
  IMAGE
  VIDEO
}

enum BrandMediaStatus {
  PENDING
  OK
  FAILED
  SKIPPED
}

// A brand's own photo (and later video) as the library understands it: what is
// in it, how it is shot, where its subject sits, how often it has been used.
// One row per Asset; the Asset stays the file. Read by the idea engine and the
// post production (docs/brand-media.md). projectId makes project deletion
// cover it.
model BrandMedia {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String
  assetId     String @unique

  kind   BrandMediaKind   @default(IMAGE)
  status BrandMediaStatus @default(PENDING)

  // Which analysis (prompt/schema generation) produced the fields below; 0 =
  // never analysed. Bumping the app's version re-analyses the library.
  version       Int       @default(0)
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  analyzedAt    DateTime?

  // Understanding. Tags are in the brand's language, lower-case.
  tags           String[] @default([])
  description    String?
  subjects       String[] @default([])
  setting        String?
  mood           String?
  shotType       String?
  orientation    String?
  hasPeople      Boolean  @default(false)
  // 0-100: how good it is as the picture of a post.
  quality        Int?
  dominantColors String[] @default([])
  // Where the main subject sits, 0-1 from the left / top.
  focalX         Float?
  focalY         Float?
  // A person edited the tags: a re-analysis keeps them.
  tagsEdited     Boolean  @default(false)

  useCount   Int       @default(0)
  lastUsedAt DateTime?
  archivedAt DateTime?

  // Video (the model is ready for it; the pipeline comes later).
  durationMs    Int?
  posterAssetId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
  @@index([projectId, archivedAt, createdAt])
  @@index([tags], type: Gin)
}

model Asset {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  type     AssetType
  source   AssetSource @default(AI_GENERATED)
  filename String
  mimeType String

  storageKey String
  size       Int
  hash       String?

  // Real pixel dimensions — measured with sharp at write time (AI-generated
  // creative images: src/server/media/creative-image.ts; user uploads:
  // library-actions.ts). Null for videos/documents and for rows created
  // before this field existed.
  width  Int?
  height Int?

  creativeVersions CreativeVersion[]
  evidences        Evidence[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
  // Newest files of a project (right panel Files, Library).
  @@index([projectId, createdAt])
}

model Creative {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String
  brandId     String

  type     CreativeType
  platform SocialPlatform?

  title String?
  brief String?

  status           CreativeStatus @default(DRAFT)
  currentVersionId String?

  createdByTaskId String?

  createdByTask Task?             @relation(fields: [createdByTaskId], references: [id], onDelete: SetNull)
  versions      CreativeVersion[] @relation("CreativeVersions")

  // Content calendar's day+time assignment (spec: takvim) — a specific
  // publish instant (UTC), not just a day: the calendar UI lets the user
  // pick both. Converted from/to the project's configured timezone (see
  // ProjectSchedule.timezone) via src/lib/timezone.ts, since a bare
  // datetime-local form value has no timezone of its own. The Instagram
  // publish queue (approval-decisions.ts) treats this as "due" once it's
  // in the past; unscheduled creatives keep the old FIFO behavior.
  scheduledFor DateTime?

  // Where and in what shape this piece is meant to go out, set when it
  // comes from a content plan (src/lib/content-channels.ts holds the
  // catalog: channel "instagram", formatKey "instagram.carousel"). Plain
  // strings validated in the app so new channels need no migration; null on
  // everything created outside a plan. `planId` groups the items saved from
  // one plan (the chat Command that drafted it); `goal` is the plan's
  // purpose (awareness/leads/sales/engagement/traffic).
  channel   String?
  formatKey String?
  goal      String?
  planId    String?

  // The post this piece is a channel delivery of (null: a piece on its own,
  // treated as a post of one). `excludedAt`: the channel was left out of the
  // post (undoable, unlike ARCHIVED); an excluded delivery is never made,
  // approved or published.
  postId     String?
  post       Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  excludedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([brandId])
  @@index([status])
  @@index([projectId, scheduledFor])
  @@index([projectId, channel])
  @@index([planId])
  @@index([postId])
  @@index([createdByTaskId])
  // The chat's progress poll (src/server/chat/progress.ts).
  @@index([projectId, updatedAt])
}

model CreativeVersion {
  id         String @id @default(cuid())
  creativeId String

  version Int

  assetId String?
  caption String?
  copy    String?

  // Which platform × content-type slot this version was generated for
  // (see src/lib/creative-platform-format.ts) — null for older rows and
  // for versions with no platform (creative.platform is also optional).
  contentFormat CreativeContentFormat?

  generationProvider String?
  generationMetadata Json?

  revisionReason String?

  creative Creative @relation("CreativeVersions", fields: [creativeId], references: [id], onDelete: Cascade)
  asset    Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([creativeId, version])
  @@index([creativeId])
}

